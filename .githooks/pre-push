#!/bin/sh
set -eu

# Git exports these to hooks. Tests that create temporary repositories would
# otherwise inherit them and run git init, config, and commit against this one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
cd "$(git rev-parse --show-toplevel)"

cd sync
bun install --frozen-lockfile
bun run gates

cd ..
uv run --script .github/scripts/ci.py local
