# ==============================================================================
# Central Agents Environment Configuration (~/.config/agents/.env)
# ==============================================================================
# Copy this file to '.env' in this directory and fill in your active credentials.
# Values are automatically loaded by 'sync' launcher wrappers and inherited by
# all harnesses (OMP, Claude Code, Codex, Pi, etc.), subshells, and MCPorter.
#
# KEY ROTATION PATTERN:
# Keep fallback keys commented out directly below the active key. When one key
# runs out of credits, uncomment the next key and save:
#   FIRECRAWL_API_KEY=fc-active-key-01
#   # FIRECRAWL_API_KEY=fc-backup-key-02
#   # FIRECRAWL_API_KEY=fc-backup-key-03
#
# NOTE: Terminal environment variables ('export KEY=...') always take precedence
# over '.env' values if you need a quick temporary session override.
# ==============================================================================

# --- Search & Web Intelligence Skills ---
# parallel-search: Parallel API key (https://platform.parallel.ai)
PARALLEL_API_KEY=

# brave-search: Brave Search API key (https://brave.com/search/api/)
BRAVE_API_KEY=
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1

# firecrawl: Firecrawl API key for scraping, crawling, and research (https://firecrawl.dev)
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# context7: Context7 API key for high-rate-limit documentation lookups (https://context7.com)
CONTEXT7_API_KEY=

# grep-app: Grep.app API override URL (optional, defaults to public endpoint)
# GREP_APP_BASE_URL=https://grep.app/api/search

# x-research: Alternative X/Twitter frontend endpoint (optional)
# X_RESEARCH_BASE_URL=https://api.fxtwitter.com


# --- AI Benchmarks & Commit Automation ---
# artificial-analysis-live: Artificial Analysis API key (https://artificialanalysis.ai)
ARTIFICIAL_ANALYSIS_API_KEY=

# autommit: Direct OpenAI or compatible model credentials for commit generation
AUTOMMIT_API_KEY=
AUTOMMIT_BASE_URL=
AUTOMMIT_MODEL=
# AUTOMMIT_REASONING_EFFORT=high   # optional: low | medium | high


# --- Workflow & Automation Skills (n8n) ---
# n8n: Self-hosted or cloud n8n instance credentials (REST API)
N8N_BASE_URL=
N8N_API_KEY=

# n8n: MCPorter Bridge configuration (via Supergateway)
# N8N_MCP_URL=https://n8n.yourdomain.com/mcp/sse
# N8N_MCP_TOKEN=


# --- Deployment & Developer Platforms ---
# github: GitHub Personal Access Token (for scripting, gh CLI, and private repo access)
GH_TOKEN=
# GITHUB_TOKEN=

# vercel-cli: Non-interactive auth token (https://vercel.com/account/tokens)
VERCEL_TOKEN=


# --- Enterprise & Specialized Integrations (Odoo) ---
# odoo-ops: JSON-RPC and Container integration credentials
ODOO_RPC_URL=
ODOO_RPC_DB=
ODOO_RPC_USER=
ODOO_RPC_TOKEN=
# ODOO_RPC_VERIFY_SSL=true


# --- Client & Community Defaults ---
# reddit: Read-only Reddit client user-agent string
REDDIT_USER_AGENT=agents-reddit/1.0
