# --- Search & Web Intelligence Skills ---
# brave-search: Brave Search API key (https://brave.com/search/api/)
BRAVE_API_KEY=

# firecrawl: Firecrawl API key for web scraping and search (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# context7: Context7 API key for higher rate limits (https://context7.com)
CONTEXT7_API_KEY=

# --- AI Benchmarks & Market Intelligence ---
# artificial-analysis-live: Artificial Analysis API key (https://artificialanalysis.ai)
ARTIFICIAL_ANALYSIS_API_KEY=

# --- Workflow & Automation Skills ---
# n8n: Self-hosted or cloud n8n instance credentials (REST API)
N8N_BASE_URL=
N8N_API_KEY=
# n8n MCP bridge (optional)
# N8N_MCP_URL=
# N8N_MCP_TOKEN=

# --- Deployment & Developer Platforms ---
# vercel-cli: Non-interactive auth token (https://vercel.com/account/tokens)
VERCEL_TOKEN=

# github: GitHub Personal Access Token for scripting / gh CLI operations
GH_TOKEN=

# --- Client & Community Defaults ---
# reddit: Read-only Reddit client user-agent
REDDIT_USER_AGENT=agents-reddit/1.0
