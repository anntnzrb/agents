{
  "name": "agents-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome check --error-on-warnings . && oxlint .",
    "check:write": "biome check --write --error-on-warnings . && oxlint --fix .",
    "format": "biome format --write . && oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "sync": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./test/integration.test.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-rc.111",
    "effect": "^4.0.0-rc.111"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@effect/tsgo": "^0.36.5",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
