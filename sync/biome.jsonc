{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../"
  },
  "files": {
    "includes": [
      ".oxlintrc.jsonc",
      "biome.jsonc",
      "package.json",
      "tsconfig.json",
      "src/**",
      "test/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error"
      },
      "complexity": {
        // TypeScript requires bracket access for dynamically keyed records.
        "useLiteralKeys": "off"
      },
      "performance": {
        "useTopLevelRegex": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useDefaultSwitchClause": "error",
        "useErrorCause": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // Test fixtures deliberately inspect partial arrays and dynamically loaded legacy APIs.
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
