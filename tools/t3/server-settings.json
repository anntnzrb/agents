{
  "continueThreadsAfterServerUpdate": true,
  "defaultThreadEnvMode": "worktree",
  "addProjectBaseDirectory": "~/repos",
  "defaultAutoPull": true,
  "defaultRuntimeMode": "full-access",
  "defaultModelSelection": {
    "instanceId": "pi",
    "model": "cliproxy/gpt-6.1-sol",
    "options": [{ "id": "thinking", "value": "medium" }]
  },
  "backgroundActivity": {
    "profile": "custom",
    "baseProfile": "performance",
    "overrides": {
      "pauseWhenHostLocked": false
    }
  },
  "storageCleanup": {
    "worktreeOnMerge": true,
    "worktreeOnDelete": true,
    "logsAfterDays": 14,
    "browserArtifactsAfterDays": 14
  },
  "pullRequestMergeMethod": "squash",
  "textGenerationModelSelection": {
    "instanceId": "pi",
    "model": "openai-codex/gpt-6.1-sol",
    "options": []
  },
  "sourceControlWritingStyle": {
    "mode": "conventional_commits"
  },
  "providers": {
    "cursor": { "enabled": false },
    "grok": { "enabled": false },
    "opencode": { "enabled": false },
    "antigravity": { "enabled": false }
  },
  "providerInstances": {
    "pi": { "driver": "pi", "enabled": true },
    "codex": { "driver": "codex", "enabled": true },
    "claudeAgent": { "driver": "claudeAgent", "enabled": true },
    "cursor": { "driver": "cursor", "enabled": false },
    "grok": { "driver": "grok", "enabled": false },
    "opencode": { "driver": "opencode", "enabled": false },
    "antigravity": { "driver": "antigravity", "enabled": false }
  }
}
