{
  // Generic agent guardrails policy.
  // Add more rules here without touching extension code.
  "version": 1,
  "agentBash": {
    "rules": [
      {
        "id": "no-python",
        "match": {
          "type": "executable",
          "names": [
            "python",
            "python3"
          ],
          "patterns": [
            "^python3(?:\\.\\d+)+$"
          ]
        },
        "action": {
          "type": "block",
          "message": "python/python3 is disabled. Load `/skill:python`."
        }
      },
      {
        "id": "no-pip",
        "match": {
          "type": "executable",
          "names": [
            "pip",
            "pip3"
          ],
          "patterns": [
            "^pip3(?:\\.\\d+)+$"
          ]
        },
        "action": {
          "type": "block",
          "message": "pip/pip3 is disabled. Load `/skill:python`."
        }
      },
      {
        "id": "no-poetry",
        "match": {
          "type": "executable",
          "names": [
            "poetry"
          ]
        },
        "action": {
          "type": "block",
          "message": "poetry is disabled. Load `/skill:python`."
        }
      },
      {
        "id": "no-python-m-pip",
        "match": {
          "type": "regex",
          "pattern": "\\bpython(?:3(?:\\.\\d+)*)?\\b[^\\n;|&]*(?:\\s-m\\s*pip\\b|\\s-mpip\\b)"
        },
        "action": {
          "type": "block",
          "message": "`python -m pip` is disabled. Load `/skill:python`."
        }
      },
      {
        "id": "no-python-m-venv",
        "match": {
          "type": "regex",
          "pattern": "\\bpython(?:3(?:\\.\\d+)*)?\\b[^\\n;|&]*(?:\\s-m\\s*venv\\b|\\s-mvenv\\b)"
        },
        "action": {
          "type": "block",
          "message": "`python -m venv` is disabled. Load `/skill:python`."
        }
      },
      {
        "id": "no-python-m-py-compile",
        "match": {
          "type": "regex",
          "pattern": "\\bpython(?:3(?:\\.\\d+)*)?\\b[^\\n;|&]*(?:\\s-m\\s*py_compile\\b|\\s-mpy_compile\\b)"
        },
        "action": {
          "type": "block",
          "message": "`python -m py_compile` is disabled. Load `/skill:python`."
        }
      },
      {
        "id": "prefer-native-file-discovery-rg-files",
        "match": {
          "type": "regex",
          "pattern": "\\b(?:rg|ripgrep)\\b[^\\n;|&]*\\s--files\\b",
          "flags": "i"
        },
        "action": {
          "type": "warn",
          "message": "Use native `find` tool for file lookup."
        }
      },
      {
        "id": "prefer-native-file-discovery-git-ls-files",
        "match": {
          "type": "regex",
          "pattern": "\\bgit\\b[^\\n;|&]*\\bls-files\\b",
          "flags": "i"
        },
        "action": {
          "type": "warn",
          "message": "Use native `find` tool for file lookup."
        }
      },
      {
        "id": "prefer-native-content-search",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": [
            "rg",
            "ripgrep",
            "ag",
            "ack",
            "ack-grep",
            "pt",
            "ugrep",
            "sift",
            "grep",
            "ggrep",
            "findstr",
            "select-string"
          ],
          "patterns": [
            "^(?:rg|ripgrep|ag|ack(?:-grep)?|pt|ugrep|sift|grep|ggrep|findstr|select-string)(?:\\.exe)?$"
          ]
        },
        "action": {
          "type": "warn",
          "message": "Use native `grep` tool for repo search."
        }
      },
      {
        "id": "prefer-native-content-search-git-grep",
        "match": {
          "type": "regex",
          "pattern": "\\bgit\\b[^\\n;|&]*\\bgrep\\b",
          "flags": "i"
        },
        "action": {
          "type": "warn",
          "message": "Use native `grep` tool for repo search."
        }
      },
      {
        "id": "prefer-native-file-discovery",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": [
            "fd",
            "fdfind",
            "fd-find",
            "find",
            "gfind",
            "locate",
            "mlocate",
            "plocate"
          ],
          "patterns": [
            "^(?:fd|fdfind|fd-find|find|gfind|locate|mlocate|plocate)(?:\\.exe)?$"
          ]
        },
        "action": {
          "type": "warn",
          "message": "Use native `find` tool for file lookup."
        }
      }
    ]
  },
  "protectedPaths": {
    "rules": [
      {
        "id": "no-read-env",
        "pattern": ".env",
        "tools": ["read"],
        "action": {
          "type": "block",
          "message": "Reading .env files is blocked by guardrails."
        }
      },
      {
        "id": "no-read-git",
        "pattern": ".git",
        "tools": ["read"],
        "action": {
          "type": "block",
          "message": "Reading .git internals is blocked by guardrails."
        }
      },
      {
        "id": "no-write-env",
        "pattern": ".env",
        "tools": ["write", "edit"],
        "action": {
          "type": "block",
          "message": "Writing .env files is blocked by guardrails."
        }
      },
      {
        "id": "no-write-git",
        "pattern": ".git",
        "tools": ["write", "edit"],
        "action": {
          "type": "block",
          "message": "Writing .git internals is blocked by guardrails."
        }
      },
      {
        "id": "no-write-node-modules",
        "pattern": "node_modules",
        "tools": ["write", "edit"],
        "action": {
          "type": "block",
          "message": "Writing node_modules is blocked by guardrails."
        }
      }
    ]
  }
}
