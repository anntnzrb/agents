{
  "imports": [],
  "mcpServers": {
    "deepwiki": {
      "description": "DeepWiki MCP",
      "serverUrl": "https://mcp.deepwiki.com/mcp",
    },
    "context7": {
      "description": "Context7 documentation MCP",
      "serverUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}",
      },
      "allowedTools": ["resolve-library-id", "query-docs"],
    },
    "openai-docs": {
      "description": "OpenAI Developer Docs MCP",
      "serverUrl": "https://developers.openai.com/mcp",
    },
    "linear": {
      "description": "Linear MCP",
      "serverUrl": "https://mcp.linear.app/mcp",
    },
    "effect": {
      "description": "Effect MCP",
      "command": "bun",
      "args": ["x", "@niklaserik/effect-mcp"],
    },
    "n8n": {
      "description": "n8n MCP",
      "command": "bun",
      "args": [
        "x",
        "supergateway",
        "--streamableHttp",
        "${N8N_MCP_URL:-}",
        "--header",
        "Authorization: Bearer ${N8N_MCP_TOKEN:-}",
      ],
    },
  },
}
