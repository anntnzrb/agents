{
  "imports": [],
  "mcpServers": {
    "deepwiki": {
      "description": "DeepWiki MCP",
      "serverUrl": "https://mcp.deepwiki.com/mcp",
    },
    "openai-docs": {
      "piSkill": "openai-docs",
      "description": "OpenAI Developer Docs MCP",
      "serverUrl": "https://developers.openai.com/mcp",
    },
    "kestra-docs": {
      "piSkill": "kestra",
      "description": "Public Kestra documentation, plugin schemas, and blueprints; no instance management",
      "serverUrl": "https://api.kestra.io/v1/mcp",
      // The public server accepts initialize but returns HTTP 500 for server/discover.
      "protocolVersion": "legacy",
    },
    "linear": {
      "piSkill": "linear",
      "description": "Linear MCP",
      "serverUrl": "https://mcp.linear.app/mcp",
    },
    "context7": {
      "piSkill": "context7",
      "description": "Context7 Docs & Libraries MCP",
      "serverUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}",
      },
    },
    "metacritic": {
      "piSkill": "metacritic",
      "description": "Metacritic films, shows, and games: Metascores, user scores, and reviews",
      "command": "bun",
      "args": ["x", "mcp-metacritic@latest"],
    },
    "n8n": {
      "piSkill": "n8n",
      "description": "n8n MCP",
      "command": "bun",
      "args": [
        "x",
        "supergateway",
        "--streamableHttp",
        "${N8N_MCP_URL:-}",
        "--header",
        "Authorization: Bearer ${N8N_MCP_TOKEN:-}",
      ],
    },
  },
}
