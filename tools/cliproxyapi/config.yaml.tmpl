host: "${CLIPROXY_LISTEN_HOST}"
port: ${CLIPROXY_LISTEN_PORT}

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: true
  secret-key: tailnet
  disable-control-panel: false
  disable-auto-update-panel: true

auth-dir: "~/.cli-proxy-api"

debug: false
logging-to-file: false
usage-statistics-enabled: true
disable-image-generation: "chat"
force-model-prefix: true
ws-auth: false

request-retry: 3
max-retry-credentials: 0
max-retry-interval: 30
disable-cooling: false
save-cooldown-status: true

# Transient upstream failures rely on the retry rounds instead of a flat 60s cooldown.
transient-error-cooldown-seconds: -1

# Quota exhaustion falls back across projects, preview variants, and paid credits
# before a request fails; a dead or exhausted credential never sinks the pool.
quota-exceeded:
  switch-project: true
  switch-preview-model: true
  antigravity-credits: true

# Non-streaming responses emit blank lines so slow upstreams never look dead.
nonstream-keepalive-interval: 15

streaming:
  # SSE keep-alives during long silent generations so clients never see dead air.
  keepalive-seconds: 15
  bootstrap-retries: 1

routing:
  strategy: "weighted-round-robin"
  session-affinity: true
  session-affinity-ttl: "1h"
  # Subagent sessions inherit the parent's credential binding.
  session-affinity-subagents: true

codex:
  identity-confuse: false
  disable-codex-cloaking: false
  # Codex Desktop/TUI/CLI multi-agent v2 request normalization.
  optimize-multi-agent-v2: true
  # Hold handshake events so overload rejections can fail over on another credential.
  stream-bootstrap-buffering: true
  # Scope usage_limit_reached cooldowns to the requested model instead of the whole credential.
  model-level-cooling: true

antigravity:
  connection-pool:
    enabled: true
  # Google's Cloud Code Assist WAF false-flags the literal "<system-conventions>"
  # and "<system-directive>" blocks that harness system prompts such as OMP's
  # ship (upstream issue #5751): the gateway returns a bogus 429
  # RESOURCE_EXHAUSTED that is not quota exhaustion. Obfuscating these tokens with a
  # zero-width space breaks the literal match while staying invisible to the model.
  sensitive-words:
    - "system-conventions"
    - "system_conventions"
    - "system-directive"
    - "system_directive"
    - "RFC 2119: MUST, REQUIRED, SHOULD, RECOMMENDED, MAY, OPTIONAL."

openai-compatibility:
  - name: "opencode-go-custom"
    base-url: "https://opencode.ai/zen/go/v1"
    prefix: "opencode-go"
    x-credential-pool: "opencode-go"
    # `$CPA-SESSION-ID` expands to the gateway's internal session identifier
    # for session affinity, so Go's required `x-opencode-session` is always
    # sent and prompt-cache affinity holds across turns. The resolver never
    # reads a client-supplied session header.
    headers:
      x-opencode-session: "$CPA-SESSION-ID"
    # Sync derives the model list from {base-url}/models.
    x-model-discovery: true
  - name: "opencode-zen-custom"
    base-url: "https://opencode.ai/zen/v1"
    prefix: "opencode-zen"
    x-credential-pool: "opencode-zen"
    headers:
      x-opencode-session: "$CPA-SESSION-ID"
    x-model-discovery: true
  - name: "cline-pass-custom"
    base-url: "https://api.cline.bot/api/v1"
    prefix: "cline-pass"
    x-credential-pool: "cline-pass"
    x-model-discovery: true
  - name: "command-code-custom"
    base-url: "https://api.commandcode.ai/provider/v1"
    prefix: "command-code"
    x-credential-pool: "command-code"
    x-model-discovery: true
  # MiMo Token Plan dedicated endpoint (OpenAI protocol).
  - name: "mimo-custom"
    base-url: "https://token-plan-sgp.xiaomimimo.com/v1"
    prefix: "mimo"
    x-credential-pool: "mimo"
    models:
      - name: "mimo-v2.6-flash"
        display-name: "MiMo-V2.6-Flash"
        max-context-length: 1048576
        thinking:
          levels:
            - "high"
      - name: "mimo-v2.6-pro"
        display-name: "MiMo-V2.6-Pro"
        max-context-length: 1048576
        thinking:
          levels:
            - "high"
