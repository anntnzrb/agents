host: "${CLIPROXY_LISTEN_HOST}"
port: ${CLIPROXY_LISTEN_PORT}

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: true
  secret-key: tailnet
  disable-control-panel: false
  disable-auto-update-panel: true

auth-dir: "~/.cli-proxy-api"

debug: false
logging-to-file: false
usage-statistics-enabled: true
disable-image-generation: "chat"
force-model-prefix: true
ws-auth: false

request-retry: 3
max-retry-credentials: 0
max-retry-interval: 30
disable-cooling: false
save-cooldown-status: true

streaming:
  bootstrap-retries: 1

routing:
  strategy: "weighted-round-robin"
  session-affinity: true
  session-affinity-ttl: "1h"

codex:
  identity-confuse: false
  disable-codex-cloaking: false
  optimize-multi-agent-v2: false

openai-compatibility:
  - name: "opencode-go-custom"
    base-url: "https://opencode.ai/zen/go/v1"
    x-credential-pool: "opencode-go"
    models:
      - name: "deepseek-v4-flash"
      - name: "deepseek-v4-pro"
  - name: "opencode-zen-custom"
    base-url: "https://opencode.ai/zen/v1"
    x-credential-pool: "opencode-zen"
  - name: "cline-pass-custom"
    base-url: "https://api.cline.bot/api/v1"
    x-credential-pool: "cline-pass"
    models:
      - name: "cline-pass/deepseek-v4-flash"
      - name: "cline-pass/deepseek-v4-pro"
      - name: "cline-pass/glm-5.3"
      - name: "cline-pass/kimi-k3"
      - name: "cline-pass/qwen3.8-max"
  - name: "command-code-custom"
    base-url: "https://api.commandcode.ai/provider/v1"
    x-credential-pool: "command-code"
    models:
      - name: "deepseek/deepseek-v4-flash"
      - name: "deepseek/deepseek-v4-pro"
      - name: "zai-org/GLM-5.3"
      - name: "moonshotai/Kimi-K3"

payload:
  override:
    - models:
        - name: "gemini-3.7-flash-high"
          protocol: "antigravity"
      params:
        "generationConfig.thinkingConfig.thinkingLevel": "medium"
    - models:
        - name: "gpt-5.6-sol"
          protocol: "codex"
      params:
        "reasoning.effort": "high"
    - models:
        - name: "gpt-5.6-luna"
          protocol: "codex"
      params:
        "reasoning.effort": "max"
    - models:
        - name: "gpt-5.6-terra"
          protocol: "codex"
      params:
        "reasoning.effort": "max"
    - models:
        - name: "deepseek-v4-flash"
        - name: "cline-pass/deepseek-v4-flash"
        - name: "deepseek/deepseek-v4-flash"
      params:
        reasoning_effort: "high"
    - models:
        - name: "deepseek-v4-pro"
        - name: "cline-pass/deepseek-v4-pro"
        - name: "deepseek/deepseek-v4-pro"
      params:
        reasoning_effort: "high"
    - models:
        - name: "deepseek-v4-flash-free"
      params:
        reasoning_effort: "high"
    - models:
        - name: "cline-pass/glm-5.3"
        - name: "zai-org/GLM-5.3"
      params:
        reasoning_effort: "max"
    - models:
        - name: "cline-pass/kimi-k3"
        - name: "moonshotai/Kimi-K3"
      params:
        reasoning_effort: "max"
    - models:
        - name: "cline-pass/qwen3.8-max"
      params:
        reasoning_effort: "xhigh"

oauth-excluded-models:
  antigravity:
    - "claude-*"
    - "gpt-oss-*"
    - "gemini-3-flash*"
    - "gemini-3.1-*"
    - "gemini-3.5-*"
    - "gemini-3.6-*"
    - "gemini-pro-agent"
  codex:
    - "codex-auto-review"
    - "gpt-5"
    - "gpt-5.1*"
    - "gpt-5.2*"
    - "gpt-5.3*"
    - "gpt-5.4*"
    - "gpt-5.5*"
    - "gpt-image-*"
  xai:
    - "grok-3-*"
    - "grok-4.20-*"
    - "grok-4.3"
    - "grok-4.5"
    - "grok-build-*"
    - "grok-composer-*"
    - "grok-imagine-*"
