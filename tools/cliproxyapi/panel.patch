diff --git a/src/utils/quota/cline.ts b/src/utils/quota/cline.ts
new file mode 100644
index 0000000..642c928
--- /dev/null
+++ b/src/utils/quota/cline.ts
@@ -0,0 +1,140 @@
+import type {
+  AuthFileItem,
+  ClineUsageLimit,
+  ClineUsageLimitsPayload,
+  OpenCodeQuotaWindow,
+} from '@/types';
+import { parseIsoToMs } from './resetInstants';
+import { clampPercent, mergeOpenCodeCompatAuthFiles, remainingFromUsedPercent } from './opencode';
+
+export const CLINE_USAGE_LIMITS_URL = 'https://api.cline.bot/api/v1/users/me/plan/usage-limits';
+
+export const CLINE_REQUEST_HEADERS = {
+  Authorization: 'Bearer $TOKEN$',
+  Accept: 'application/json',
+} as const;
+
+type OpenAICompatProviderLike = {
+  name?: string;
+  baseUrl?: string;
+  disabled?: boolean;
+  apiKeyEntries?: Array<{ authIndex?: string; apiKey?: string }>;
+};
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  Boolean(value) && typeof value === 'object' && !Array.isArray(value);
+
+const readString = (value: unknown): string =>
+  typeof value === 'string' ? value.trim() : value == null ? '' : String(value).trim();
+
+export function isClineBaseUrl(value: unknown): boolean {
+  const raw = readString(value);
+  if (!raw) return false;
+  try {
+    const parsed = new URL(raw);
+    if (parsed.protocol !== 'https:' || parsed.hostname.toLowerCase() !== 'api.cline.bot') {
+      return false;
+    }
+    return parsed.pathname.replace(/\/+$/, '') === '/api/v1';
+  } catch {
+    return false;
+  }
+}
+
+function extractBaseUrl(file: AuthFileItem): string {
+  const record = file as Record<string, unknown>;
+  for (const candidate of [record.baseUrl, record['base-url'], record.base_url, record.BaseURL]) {
+    const value = readString(candidate);
+    if (value) return value;
+  }
+  return '';
+}
+
+export function isClineFile(file: AuthFileItem): boolean {
+  return isClineBaseUrl(extractBaseUrl(file));
+}
+
+export function parseClineUsageLimitsPayload(input: unknown): ClineUsageLimitsPayload | null {
+  if (!isRecord(input)) return null;
+  const data = isRecord(input.data) ? input.data : null;
+  if (!data || !Array.isArray(data.limits) || data.limits.length === 0) return null;
+  const limits = data.limits.flatMap<ClineUsageLimit>((value) => {
+    if (!isRecord(value)) return [];
+    const type = readString(value.type);
+    if (type !== 'five_hour' && type !== 'weekly' && type !== 'monthly') return [];
+    const percentUsed = clampPercent(value.percentUsed ?? value.percent_used);
+    const resetsAt = readString(value.resetsAt ?? value.resets_at) || null;
+    return [{ type, percentUsed, resetsAt }];
+  });
+  return limits.length > 0 ? { limits } : null;
+}
+
+const CLINE_WINDOW_SPECS = [
+  { type: 'five_hour' as const, id: '5h' as const, labelKey: 'cline_quota.window_5h' },
+  { type: 'weekly' as const, id: 'weekly' as const, labelKey: 'cline_quota.window_week' },
+  { type: 'monthly' as const, id: 'monthly' as const, labelKey: 'cline_quota.window_month' },
+];
+
+export function buildClineQuotaWindows(payload: ClineUsageLimitsPayload): OpenCodeQuotaWindow[] {
+  return CLINE_WINDOW_SPECS.map((spec) => {
+    const limit = payload.limits.find((candidate) => candidate.type === spec.type);
+    const usedPercent = limit?.percentUsed ?? null;
+    const resetsAt = limit?.resetsAt ?? null;
+    return {
+      id: spec.id,
+      labelKey: spec.labelKey,
+      usedPercent,
+      remainingPercent: remainingFromUsedPercent(usedPercent),
+      resetAtMs: parseIsoToMs(resetsAt),
+      resetLabel: resetsAt ?? '',
+    };
+  });
+}
+
+export function mergeClineCompatAuthFiles(
+  files: AuthFileItem[],
+  compatProviders: OpenAICompatProviderLike[]
+): AuthFileItem[] {
+  const existingAuthIndexes = new Set(
+    files.flatMap((file) => {
+      const authIndex = readString(file.authIndex ?? file['auth_index']);
+      return authIndex ? [authIndex] : [];
+    })
+  );
+  const synthesized: AuthFileItem[] = [];
+  for (const provider of compatProviders) {
+    const baseUrl = readString(provider.baseUrl);
+    if (!isClineBaseUrl(baseUrl) || provider.disabled === true) continue;
+    const providerName = readString(provider.name) || 'ClinePass';
+    for (const entry of provider.apiKeyEntries ?? []) {
+      const authIndex = readString(entry.authIndex);
+      if (!authIndex || existingAuthIndexes.has(authIndex)) continue;
+      synthesized.push({
+        name: `openai-compat:${providerName}:${authIndex}`,
+        authIndex,
+        auth_index: authIndex,
+        baseUrl,
+        'base-url': baseUrl,
+        provider: 'openai-compatible',
+        type: 'openai-compatible',
+        label: providerName,
+        disabled: false,
+        source: 'openai-compatibility',
+        runtime_only: true,
+        runtimeOnly: true,
+      } as AuthFileItem);
+      existingAuthIndexes.add(authIndex);
+    }
+  }
+  return synthesized.length > 0 ? [...files, ...synthesized] : files;
+}
+
+export function mergeQuotaCompatAuthFiles(
+  files: AuthFileItem[],
+  compatProviders: OpenAICompatProviderLike[]
+): AuthFileItem[] {
+  return mergeClineCompatAuthFiles(
+    mergeOpenCodeCompatAuthFiles(files, compatProviders),
+    compatProviders
+  );
+}
