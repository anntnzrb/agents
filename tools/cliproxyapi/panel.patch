diff --git a/src/features/quota/quotaPoolModel.ts b/src/features/quota/quotaPoolModel.ts
new file mode 100644
index 0000000..793dc7f
--- /dev/null
+++ b/src/features/quota/quotaPoolModel.ts
@@ -0,0 +1,267 @@
+/**
+ * Quota pool: every credential of one provider stacked into a single capacity.
+ *
+ * Three Claude accounts are a 300% pool; each window row sums what every
+ * account still has left in that window. Pure functions — the page injects the
+ * cached quota state, so every aggregation rule here is directly testable.
+ */
+
+import { getQuotaCard } from '@/utils/quota/custom';
+import type { QuotaFileEntry } from './logic';
+import type { QuotaProviderType } from './providers/types';
+
+/** One account's slot in a pooled window; `remaining` is null when it did not report. */
+export interface QuotaPoolSlot {
+  name: string;
+  remaining: number | null;
+}
+
+export interface QuotaPoolWindow extends QuotaPoolLabel {
+  key: string;
+  /** Sum of reported remaining percent across the pool's accounts. */
+  remaining: number;
+  /** 100 per account in the pool. */
+  capacity: number;
+  /** Accounts that reported this window. */
+  reporting: number;
+  /** One slot per pool account, in account order. */
+  slots: QuotaPoolSlot[];
+}
+
+export interface QuotaPoolGroup {
+  id: string;
+  provider: QuotaProviderType;
+  /** Custom-card title; other providers are labelled by their type. */
+  title: string | null;
+  accounts: number;
+  loaded: number;
+  failed: number;
+  windows: QuotaPoolWindow[];
+}
+
+/** A window label: literal text, or an i18n key the page translates. */
+export interface QuotaPoolLabel {
+  label: string;
+  labelKey?: string;
+  labelParams?: Record<string, string | number>;
+}
+
+interface PoolLimit extends QuotaPoolLabel {
+  key: string;
+  remaining: number;
+}
+
+interface WindowLike {
+  id?: string;
+  label?: string;
+  labelKey?: string;
+  labelParams?: Record<string, string | number>;
+  usedPercent?: number | null;
+  remainingPercent?: number | null;
+}
+
+interface AntigravityGroupLike {
+  label?: string;
+  buckets?: { id?: string; label?: string; remainingFraction?: number | null }[];
+}
+
+interface KimiRowLike extends WindowLike {
+  used: number;
+  limit: number;
+}
+
+interface XaiBillingLike {
+  periodType?: string;
+  usagePercent?: number | null;
+}
+
+const isNumber = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value);
+
+const clampPercent = (value: number) => Math.min(100, Math.max(0, value));
+
+/** Literal label when present, otherwise the i18n key it was built from. */
+const labelOf = (window: WindowLike, fallback: string): QuotaPoolLabel =>
+  window.label
+    ? { label: window.label }
+    : window.labelKey
+      ? { label: fallback, labelKey: window.labelKey, labelParams: window.labelParams }
+      : { label: fallback };
+
+/**
+ * Windows one account reports, keyed so the same window lines up across accounts.
+ *
+ * Read straight from each provider's state rather than through the timeline
+ * lane: the lane keeps only windows with a reset instant, and an untouched
+ * window (no reset scheduled yet) is exactly the one with 100% left.
+ */
+export function poolLimitsFor(
+  provider: QuotaProviderType,
+  quota: { status?: string } | undefined
+): PoolLimit[] {
+  if (!quota || quota.status !== 'success') return [];
+
+  switch (provider) {
+    case 'claude':
+    case 'codex':
+    case 'devin':
+    case 'custom': {
+      // Claude and Codex store percent USED; Devin and custom cards store REMAINING.
+      const windows = (quota as { windows?: WindowLike[] }).windows ?? [];
+      return windows.flatMap((window, index) => {
+        const remaining = isNumber(window.remainingPercent)
+          ? window.remainingPercent
+          : isNumber(window.usedPercent)
+            ? 100 - window.usedPercent
+            : null;
+        if (remaining === null) return [];
+        const key = window.id || window.label || String(index);
+        return [{ key, ...labelOf(window, key), remaining: clampPercent(remaining) }];
+      });
+    }
+    case 'antigravity': {
+      // Buckets repeat their window name per group ("Weekly"), so key by group too.
+      const groups = (quota as { groups?: AntigravityGroupLike[] }).groups ?? [];
+      return groups.flatMap((group) =>
+        (group.buckets ?? []).flatMap((bucket) => {
+          if (!isNumber(bucket.remainingFraction)) return [];
+          const groupLabel = group.label ?? '';
+          const bucketLabel = bucket.label ?? bucket.id ?? '';
+          const label =
+            !groupLabel || bucketLabel.includes(groupLabel)
+              ? bucketLabel
+              : `${groupLabel} · ${bucketLabel}`;
+          return [
+            {
+              key: label,
+              label,
+              remaining: clampPercent(Math.round(bucket.remainingFraction * 100)),
+            },
+          ];
+        })
+      );
+    }
+    case 'kimi': {
+      // Kimi reports raw counts; remaining is derived.
+      const rows = (quota as { rows?: KimiRowLike[] }).rows ?? [];
+      return rows.flatMap((row, index) => {
+        if (!(row.limit > 0)) return [];
+        const key = row.id || row.label || String(index);
+        return [
+          {
+            key,
+            ...labelOf(row, key),
+            remaining: clampPercent(Math.round(((row.limit - row.used) / row.limit) * 100)),
+          },
+        ];
+      });
+    }
+    case 'xai': {
+      const billing = (quota as { billing?: XaiBillingLike | null }).billing;
+      if (!billing || !isNumber(billing.usagePercent)) return [];
+      const period = billing.periodType || 'billing';
+      return [
+        {
+          key: period,
+          label: period.charAt(0).toUpperCase() + period.slice(1),
+          remaining: clampPercent(100 - billing.usagePercent),
+        },
+      ];
+    }
+    case 'meta': {
+      const windows =
+        (quota as { data?: { windows?: { id: string; usedPercent?: number | null }[] } }).data
+          ?.windows ?? [];
+      return windows.flatMap((window) =>
+        isNumber(window.usedPercent)
+          ? [
+              {
+                key: window.id,
+                label: window.id,
+                labelKey: `meta_quota.${window.id}`,
+                remaining: clampPercent(100 - window.usedPercent),
+              },
+            ]
+          : []
+      );
+    }
+    default:
+      return [];
+  }
+}
+
+/** Pool key: provider type, except custom cards pool per card (OpenCode Go ≠ ClinePass). */
+function poolIdentity(entry: QuotaFileEntry): { id: string; title: string | null } {
+  if (entry.type !== 'custom') return { id: entry.type, title: null };
+  const card = getQuotaCard(entry.file);
+  return card ? { id: `custom:${card.id}`, title: card.title } : { id: 'custom', title: null };
+}
+
+/**
+ * Group entries into pools and sum each window across the pool's accounts.
+ *
+ * Capacity counts every account, loaded or not, so an unreported account reads
+ * as missing headroom rather than silently shrinking the pool. Window order
+ * follows first appearance, which keeps each provider's own ordering.
+ *
+ * A pool whose accounts all loaded yet report no window (xAI without a usage
+ * plan) is dropped: there is no capacity to stack. Pools still loading or with
+ * a failed account stay, so pending and failed states remain visible.
+ */
+export function buildQuotaPool(
+  entries: readonly QuotaFileEntry[],
+  quotaFor: (entry: QuotaFileEntry) => { status?: string } | undefined
+): QuotaPoolGroup[] {
+  const pools = new Map<string, { group: QuotaPoolGroup; members: QuotaFileEntry[] }>();
+  for (const entry of entries) {
+    const { id, title } = poolIdentity(entry);
+    let pool = pools.get(id);
+    if (!pool) {
+      pool = {
+        group: { id, provider: entry.type, title, accounts: 0, loaded: 0, failed: 0, windows: [] },
+        members: [],
+      };
+      pools.set(id, pool);
+    }
+    pool.members.push(entry);
+  }
+
+  return Array.from(pools.values())
+    .map(({ group, members }) => {
+      const windows = new Map<string, { label: QuotaPoolLabel; values: (number | null)[] }>();
+      members.forEach((entry, index) => {
+        const quota = quotaFor(entry);
+        if (quota?.status === 'success') group.loaded += 1;
+        else if (quota?.status === 'error') group.failed += 1;
+
+        for (const limit of poolLimitsFor(entry.type, quota)) {
+          let window = windows.get(limit.key);
+          if (!window) {
+            const { label, labelKey, labelParams } = limit;
+            window = { label: { label, labelKey, labelParams }, values: members.map(() => null) };
+            windows.set(limit.key, window);
+          }
+          // A duplicate key within one account keeps the first report.
+          if (window.values[index] === null) window.values[index] = limit.remaining;
+        }
+      });
+
+      group.accounts = members.length;
+      group.windows = Array.from(windows.entries()).map(([key, { label, values }]) => {
+        const reported = values.filter((value): value is number => value !== null);
+        return {
+          key,
+          ...label,
+          remaining: reported.reduce((sum, value) => sum + value, 0),
+          capacity: members.length * 100,
+          reporting: reported.length,
+          slots: members.map((entry, index) => ({
+            name: entry.file.name,
+            remaining: values[index],
+          })),
+        };
+      });
+      return group;
+    })
+    .filter((group) => group.windows.length > 0 || group.loaded < group.accounts);
+}
