diff --git a/tests/quotaPool.test.ts b/tests/quotaPool.test.ts
new file mode 100644
index 0000000..5930a1e
--- /dev/null
+++ b/tests/quotaPool.test.ts
@@ -0,0 +1,159 @@
+import { describe, expect, test } from 'bun:test';
+import type { AuthFileItem } from '../src/types';
+import type { QuotaFileEntry } from '../src/features/quota/logic';
+import { buildQuotaPool, poolLimitsFor } from '../src/features/quota/quotaPoolModel';
+
+const entry = (name: string, type: QuotaFileEntry['type'], extra: Partial<AuthFileItem> = {}) =>
+  ({ file: { name, type, ...extra } as AuthFileItem, type }) as QuotaFileEntry;
+
+const claude = (used5h: number, usedWeekly: number) => ({
+  status: 'success',
+  windows: [
+    { id: 'five-hour', label: '5 Hour', usedPercent: used5h, resetAtMs: 1, periodHours: 5 },
+    { id: 'weekly', label: 'Weekly', usedPercent: usedWeekly, resetAtMs: 2, periodHours: 168 },
+  ],
+});
+
+describe('buildQuotaPool', () => {
+  test('stacks every account of a provider into one capacity', () => {
+    const entries = [entry('a', 'claude'), entry('b', 'claude'), entry('c', 'claude')];
+    const quota: Record<string, unknown> = {
+      a: claude(20, 50),
+      b: claude(100, 10),
+      c: claude(0, 0),
+    };
+
+    const [pool] = buildQuotaPool(entries, (e) => quota[e.file.name] as { status: string });
+
+    expect(pool.id).toBe('claude');
+    expect(pool.accounts).toBe(3);
+    expect(pool.loaded).toBe(3);
+    expect(pool.windows.map((w) => [w.label, w.remaining, w.capacity])).toEqual([
+      ['5 Hour', 180, 300],
+      ['Weekly', 240, 300],
+    ]);
+    expect(pool.windows[0].slots.map((slot) => slot.remaining)).toEqual([80, 0, 100]);
+  });
+
+  test('keeps unreported accounts in capacity and counts failures', () => {
+    const entries = [entry('a', 'claude'), entry('b', 'claude'), entry('c', 'claude')];
+    const quota: Record<string, unknown> = {
+      a: claude(50, 50),
+      b: { status: 'error', error: 'boom' },
+    };
+
+    const [pool] = buildQuotaPool(entries, (e) => quota[e.file.name] as { status: string });
+
+    expect(pool.loaded).toBe(1);
+    expect(pool.failed).toBe(1);
+    expect(pool.windows[0]).toMatchObject({ remaining: 50, capacity: 300, reporting: 1 });
+    expect(pool.windows[0].slots.map((slot) => slot.remaining)).toEqual([50, null, null]);
+  });
+
+  test('pools each provider separately, in entry order', () => {
+    const entries = [entry('a', 'claude'), entry('g', 'antigravity'), entry('b', 'claude')];
+    const pools = buildQuotaPool(entries, () => undefined);
+    expect(pools.map((pool) => [pool.id, pool.accounts])).toEqual([
+      ['claude', 2],
+      ['antigravity', 1],
+    ]);
+    expect(pools[0].windows).toEqual([]);
+  });
+
+  test('hides a provider whose accounts all loaded but report no usage', () => {
+    const entries = [
+      entry('a', 'claude'),
+      entry('x', 'xai'),
+      entry('y', 'xai'),
+      entry('d', 'devin'),
+    ];
+    const quota: Record<string, unknown> = {
+      a: claude(0, 0),
+      x: { status: 'success', billing: { periodType: 'weekly', usagePercent: null } },
+      y: { status: 'success', billing: null },
+      d: { status: 'error', error: 'boom' },
+    };
+
+    const pools = buildQuotaPool(entries, (e) => quota[e.file.name] as { status: string });
+
+    // xAI is gone; a failed Devin still shows so the failure stays visible.
+    expect(pools.map((pool) => pool.id)).toEqual(['claude', 'devin']);
+  });
+
+  test('keeps a silent provider visible until every account has loaded', () => {
+    const entries = [entry('x', 'xai'), entry('y', 'xai')];
+    const quota: Record<string, unknown> = { x: { status: 'success', billing: null } };
+    const pools = buildQuotaPool(entries, (e) => quota[e.file.name] as { status: string });
+    expect(pools.map((pool) => pool.id)).toEqual(['xai']);
+  });
+});
+
+describe('poolLimitsFor', () => {
+  test('keeps Antigravity buckets apart per group', () => {
+    const limits = poolLimitsFor('antigravity', {
+      status: 'success',
+      groups: [
+        { label: 'Gemini', buckets: [{ label: 'Weekly', remainingFraction: 0.4 }] },
+        { label: 'Claude', buckets: [{ label: 'Weekly', remainingFraction: 1 }] },
+        { label: 'Flash', buckets: [{ label: 'Flash 5h', remainingFraction: 0.255 }] },
+      ],
+    } as { status: string });
+
+    expect(limits).toEqual([
+      { key: 'Gemini · Weekly', label: 'Gemini · Weekly', remaining: 40 },
+      { key: 'Claude · Weekly', label: 'Claude · Weekly', remaining: 100 },
+      { key: 'Flash 5h', label: 'Flash 5h', remaining: 26 },
+    ]);
+  });
+
+  test('counts an untouched window with no reset instant as fully available', () => {
+    const limits = poolLimitsFor('claude', {
+      status: 'success',
+      windows: [{ id: 'five-hour', label: '5 Hour', usedPercent: 0, resetAtMs: null }],
+    } as { status: string });
+    expect(limits).toEqual([{ key: 'five-hour', label: '5 Hour', remaining: 100 }]);
+  });
+
+  test('reads remaining percent for custom cards and Devin', () => {
+    const quota = {
+      status: 'success',
+      windows: [{ id: 'weekly', label: 'Weekly', remainingPercent: 35, resetAtMs: null }],
+    } as { status: string };
+    expect(poolLimitsFor('custom', quota)[0].remaining).toBe(35);
+    expect(poolLimitsFor('devin', quota)[0].remaining).toBe(35);
+  });
+
+  test('pools xAI billing regardless of period and keeps i18n labels for Meta and Kimi', () => {
+    expect(
+      poolLimitsFor('xai', {
+        status: 'success',
+        billing: { periodType: 'monthly', usagePercent: 25 },
+      } as { status: string })
+    ).toEqual([{ key: 'monthly', label: 'Monthly', remaining: 75 }]);
+    expect(
+      poolLimitsFor('meta', {
+        status: 'success',
+        data: { windows: [{ id: 'weekly', usedPercent: 40 }] },
+      } as { status: string })
+    ).toEqual([{ key: 'weekly', label: 'weekly', labelKey: 'meta_quota.weekly', remaining: 60 }]);
+    expect(
+      poolLimitsFor('kimi', {
+        status: 'success',
+        rows: [{ id: 'total', labelKey: 'kimi_quota.total', used: 30, limit: 120 }],
+      } as { status: string })
+    ).toEqual([
+      {
+        key: 'total',
+        label: 'total',
+        labelKey: 'kimi_quota.total',
+        labelParams: undefined,
+        remaining: 75,
+      },
+    ]);
+  });
+
+  test('reports nothing until quota has loaded', () => {
+    expect(poolLimitsFor('claude', undefined)).toEqual([]);
+    expect(poolLimitsFor('claude', { status: 'loading' })).toEqual([]);
+  });
+});
