@@ -0,0 +1,82 @@
+/**
+ * Generic quota provider: all cards defined by `@/utils/quota/custom/cards`.
+ */
+
+import type { TFunction } from 'i18next';
+import type { AuthFileItem, CustomQuotaState, CustomQuotaWindow } from '@/types';
+import { apiCallApi, getApiCallErrorMessage } from '@/services/api';
+import { createStatusError, isDisabledAuthFile } from '@/utils/quota';
+import { getQuotaCard } from '@/utils/quota/custom';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import type { QuotaProviderData } from '../types';
+
+export type CustomQuotaData = {
+  cardId: string;
+  cardTitle: string;
+  windows: CustomQuotaWindow[];
+};
+
+const mapStatusError = (status: number, fallback: string, t: TFunction) => {
+  if (status === 401) return t('custom_quota.unauthorized');
+  if (status === 403) return t('custom_quota.subscription_required');
+  if (status === 429) return t('custom_quota.rate_limited');
+  if (status >= 500) return t('custom_quota.upstream_unavailable');
+  return fallback;
+};
+
+const fetchCustomQuota = async (file: AuthFileItem, t: TFunction): Promise<CustomQuotaData> => {
+  const card = getQuotaCard(file);
+  if (!card) throw new Error(t('custom_quota.no_card'));
+
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) throw new Error(t('custom_quota.missing_auth_index'));
+
+  let result;
+  try {
+    result = await apiCallApi.request({ authIndex, ...card.request(file) });
+  } catch (err: unknown) {
+    const message = err instanceof Error ? err.message : t('custom_quota.request_failed');
+    throw createStatusError(t('custom_quota.request_failed_with_message', { message }), undefined);
+  }
+
+  if (result.statusCode < 200 || result.statusCode >= 300) {
+    const fallback = getApiCallErrorMessage(result);
+    throw createStatusError(mapStatusError(result.statusCode, fallback, t), result.statusCode);
+  }
+
+  const windows = card.parse(result.body ?? result.bodyText);
+  if (!windows || windows.length === 0) {
+    throw new Error(t('custom_quota.invalid_response'));
+  }
+  if (
+    !windows.some(
+      (window) =>
+        window.remainingPercent !== null || window.resetAtMs != null || window.displayValue
+    )
+  ) {
+    throw new Error(t('custom_quota.empty_data'));
+  }
+  return { cardId: card.id, cardTitle: card.title, windows };
+};
+
+export const CUSTOM_CONFIG: QuotaProviderData<CustomQuotaState, CustomQuotaData> = {
+  type: 'custom',
+  i18nPrefix: 'custom_quota',
+  filterFn: (file) => getQuotaCard(file) !== undefined && !isDisabledAuthFile(file),
+  fetchQuota: fetchCustomQuota,
+  storeSelector: (state) => state.customQuota,
+  storeSetter: 'setCustomQuota',
+  buildLoadingState: () => ({ status: 'loading', windows: [] }),
+  buildSuccessState: (data) => ({
+    status: 'success',
+    windows: data.windows,
+    cardId: data.cardId,
+    cardTitle: data.cardTitle,
+  }),
+  buildErrorState: (message, status) => ({
+    status: 'error',
+    windows: [],
+    error: message,
+    errorStatus: status,
+  }),
+};
