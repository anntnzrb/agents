+++ b/tests/openRouterQuota.test.tsx
@@ -0,0 +1,164 @@
+import { describe, expect, test } from 'bun:test';
+import { renderToStaticMarkup } from 'react-dom/server';
+import i18n from '@/i18n';
+import { QUOTA_CARDS } from '@/utils/quota/custom';
+import { mergeQuotaCompatAuthFiles } from '@/utils/quota/compat';
+import { classifyQuotaFiles, filterEntriesByTab, buildTabCounts } from '@/features/quota/logic';
+import { CUSTOM_CONFIG } from '@/features/quota/providers/custom/data';
+import { CustomQuotaBody } from '@/features/quota/providers/custom/CustomQuotaBody';
+import { QUOTA_CLASS_KEYS } from '@/features/quota/types';
+import { apiClient } from '@/services/api/client';
+import { providersApi } from '@/services/api/providers';
+import { useAuthStore } from '@/stores/useAuthStore';
+import type { QuotaClassMap } from '@/features/quota/types';
+
+const card = () => QUOTA_CARDS.find((entry) => entry.id === 'openrouter')!;
+const payload = (data: Record<string, unknown>) => ({
+  data: { limit: 10, limit_remaining: 7.5, usage: 2.5, limit_reset: 'monthly', ...data },
+});
+const classes = Object.fromEntries(
+  QUOTA_CLASS_KEYS.map((key) => [key, key])
+) as unknown as QuotaClassMap;
+const render = (data: Record<string, unknown>) =>
+  renderToStaticMarkup(
+    <CustomQuotaBody
+      quota={{ status: 'success', windows: card().parse(payload(data))! }}
+      classes={classes}
+    />
+  );
+
+describe('OpenRouter key budgets', () => {
+  test('uses the authenticated key endpoint and exact provider URL', () => {
+    expect(card()?.request({ name: 'key' })).toMatchObject({
+      method: 'GET',
+      url: 'https://openrouter.ai/api/v1/key',
+      header: { Authorization: 'Bearer $TOKEN$' },
+    });
+    expect(card()?.matchesBaseUrl?.('https://openrouter.ai/api/v1/')).toBe(true);
+    expect(card()?.matchesBaseUrl?.('https://openrouter.ai.attacker.invalid/api/v1')).toBe(false);
+  });
+  test('renders remaining dollars, cap and spend without inventing a reset instant', () => {
+    const windows = card().parse(payload({ usage_daily: 0.000042, usage_monthly: 2.5 }))!;
+    expect(windows[0].remainingPercent).toBe(75);
+    expect(windows.every((window) => window.resetAtMs == null)).toBe(true);
+    const html = render({ usage_daily: 0.000042, usage_monthly: 2.5 });
+    expect(html).toContain('$7.50 left');
+    expect(html).toContain('Cap $10.00');
+    expect(html).toContain('Resets monthly');
+    expect(html).toContain('$0.000042');
+    expect(html).toContain('width:75%');
+  });
+  test('unlimited keys still show spend with no percentage bar', () => {
+    const html = render({ limit: null, limit_remaining: null, usage: 3 });
+    expect(html).toContain('No key limit');
+    expect(html).toContain('$3.00');
+    expect(html).not.toContain('quotaBar');
+  });
+  test('zero-dollar limits remain finite and visibly exhausted', () => {
+    expect(card().parse(payload({ limit: 0, limit_remaining: 0 }))?.[0].remainingPercent).toBe(0);
+    expect(render({ limit: 0, limit_remaining: 0 })).toContain('$0.00 left');
+  });
+  test.each([
+    {},
+    { data: [] },
+    payload({ limit: '10' }),
+    payload({ limit_remaining: NaN }),
+    payload({ usage: -1 }),
+    payload({ usage_daily: '0' }),
+    payload({ limit: null, limit_remaining: 'invalid' }),
+  ])('rejects malformed key payloads', (input) => {
+    expect(card().parse(input)).toBeNull();
+  });
+  test('two keys get separate standard rows, dedup and provider tab counts', () => {
+    const providers = [
+      {
+        name: 'openrouter',
+        baseUrl: 'https://openrouter.ai/api/v1',
+        apiKeyEntries: [{ authIndex: 'key-one' }, { authIndex: 'key-two' }],
+      },
+    ];
+    const rows = mergeQuotaCompatAuthFiles([], providers);
+    expect(rows).toHaveLength(2);
+    expect(mergeQuotaCompatAuthFiles(rows, providers)).toHaveLength(2);
+    const entries = classifyQuotaFiles(rows);
+    expect(filterEntriesByTab(entries, 'custom:openrouter')).toHaveLength(2);
+    expect(buildTabCounts(entries)['custom:openrouter']).toBe(2);
+  });
+  test('real management requests preserve per-key identity and show unlimited/error states', async () => {
+    const requests: Record<string, unknown>[] = [];
+    const server = Bun.serve({
+      hostname: '127.0.0.1',
+      port: 0,
+      async fetch(request) {
+        const path = new URL(request.url).pathname;
+        if (path === '/v0/management/openai-compatibility') {
+          return Response.json({
+            'openai-compatibility': [
+              { name: 'keyless-local', 'base-url': 'http://127.0.0.1:1/v1', models: [] },
+              {
+                name: 'openrouter',
+                'base-url': 'https://openrouter.ai/api/v1',
+                'api-key-entries': [
+                  { 'api-key': 'fake-one', 'auth-index': 'key-one' },
+                  { 'api-key': 'fake-two', 'auth-index': 'key-two' },
+                ],
+              },
+            ],
+          });
+        }
+        expect(path).toBe('/v8/management/requests/api-call');
+        const body = (await request.json()) as Record<string, unknown>;
+        requests.push(body);
+        const forbidden = body.authIndex === 'denied';
+        return Response.json({
+          status_code: forbidden ? 401 : 200,
+          body: forbidden
+            ? { error: { message: 'denied' } }
+            : payload({ limit: null, limit_remaining: null, usage: 1 }),
+        });
+      },
+    });
+    apiClient.setConfig({
+      apiBase: `http://127.0.0.1:${server.port}`,
+      managementKey: 'fake-management',
+    });
+    try {
+      useAuthStore.getState().apiBase = `http://127.0.0.1:${server.port}`;
+      const providers = await providersApi.getQuotaOpenAIProviders();
+      const rows = mergeQuotaCompatAuthFiles([], providers);
+      expect(rows).toHaveLength(2);
+      expect(rows.map((row) => row.auth_index)).toEqual(['key-one', 'key-two']);
+      for (const authIndex of rows.map((row) => String(row.auth_index))) {
+        const result = await CUSTOM_CONFIG.fetchQuota(
+          { name: authIndex, auth_index: authIndex, baseUrl: 'https://openrouter.ai/api/v1' },
+          i18n.t
+        );
+        expect(result.windows[0].remainingPercent).toBeNull();
+        expect(result.windows[0].displayValue).toBe('No key limit');
+      }
+      await expect(
+        CUSTOM_CONFIG.fetchQuota(
+          { name: 'denied', auth_index: 'denied', baseUrl: 'https://openrouter.ai/api/v1' },
+          i18n.t
+        )
+      ).rejects.toThrow();
+      expect(requests.map((request) => request.authIndex)).toEqual([
+        'key-one',
+        'key-two',
+        'denied',
+      ]);
+      expect(requests.every((request) => request.url === 'https://openrouter.ai/api/v1/key')).toBe(
+        true
+      );
+      expect(
+        requests.every(
+          (request) => (request.header as Record<string, string>).Authorization === 'Bearer $TOKEN$'
+        )
+      ).toBe(true);
+    } finally {
+      server.stop(true);
+      apiClient.setConfig({ apiBase: '', managementKey: '' });
+      useAuthStore.getState().apiBase = '';
+    }
+  });
+});
diff --git a/tests/providerTabsRegression.test.ts b/tests/providerTabsRegression.test.ts
new file mode 100644
index 0000000..133263b
--- /dev/null
+++ b/tests/providerTabsRegression.test.ts
@@ -0,0 +1,61 @@
+import { expect, test } from 'bun:test';
+import { classifyQuotaFiles, filterEntriesByTab, buildTabCounts } from '@/features/quota/logic';
+import { QUOTA_CARDS, type QuotaCard } from '@/utils/quota/custom';
+import { getQuotaTabIds } from '@/features/quota/constants';
+import type { AuthFileItem } from '@/types';
+const files = [
+  { name: 'devin.json', provider: 'devin' },
+  { name: 'go.json', provider: 'openai', baseUrl: 'https://opencode.ai/zen/go' },
+  { name: 'cline.json', provider: 'openai', baseUrl: 'https://api.cline.bot/api/v1' },
+] as AuthFileItem[];
+test('native Devin and custom providers have separate tabs and counts', () => {
+  const entries = classifyQuotaFiles(files);
+  expect(filterEntriesByTab(entries, 'devin').map((e) => e.file.name)).toEqual(['devin.json']);
+  expect(filterEntriesByTab(entries, 'custom:opencode-go').map((e) => e.file.name)).toEqual([
+    'go.json',
+  ]);
+  expect(filterEntriesByTab(entries, 'custom:cline-pass').map((e) => e.file.name)).toEqual([
+    'cline.json',
+  ]);
+  expect(buildTabCounts(entries)).toMatchObject({
+    all: 3,
+    devin: 1,
+    'custom:opencode-go': 1,
+    'custom:cline-pass': 1,
+  });
+});
+test('a new registry provider gets its own tab without page edits', () => {
+  const card = {
+    id: 'future',
+    title: 'Future',
+    matches: (f: AuthFileItem) => f.provider === 'future',
+    request: () => ({ method: 'GET', url: 'https://example.invalid' }),
+    parse: () => [],
+  };
+  const cards = QUOTA_CARDS as QuotaCard[];
+  cards.push(card);
+  try {
+    expect(getQuotaTabIds()).toContain('custom:future');
+    const entries = classifyQuotaFiles([{ name: 'new.json', provider: 'future' } as AuthFileItem]);
+    expect(filterEntriesByTab(entries, 'custom:future')).toHaveLength(1);
+    expect(buildTabCounts(entries)['custom:future']).toBe(1);
+  } finally {
+    cards.pop();
+  }
+});
+
+test('native providers win even when a custom matcher overlaps', () => {
+  const cards = QUOTA_CARDS as QuotaCard[];
+  cards.push({
+    id: 'overlap',
+    title: 'Overlap',
+    matches: () => true,
+    request: () => ({ method: 'GET', url: 'https://example.invalid' }),
+    parse: () => [],
+  });
+  try {
+    expect(classifyQuotaFiles([files[0]])[0].type).toBe('devin');
+  } finally {
+    cards.pop();
+  }
+});
