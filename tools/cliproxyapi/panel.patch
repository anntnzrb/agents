diff --git a/src/features/quota/providers/cline/ClineQuotaBody.tsx b/src/features/quota/providers/cline/ClineQuotaBody.tsx
new file mode 100644
index 0000000..9ecfb25
--- /dev/null
+++ b/src/features/quota/providers/cline/ClineQuotaBody.tsx
@@ -0,0 +1,58 @@
+import { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { ClineQuotaState } from '@/types';
+import { buildResetDisplay } from '@/utils/quota';
+import { useNow } from '@/hooks/useNow';
+import { QuotaMeter } from '../../components/QuotaMeter';
+import { QuotaResetLabel } from '../../components/QuotaResetLabel';
+import { collectQuotaRowInstants, pickUrgentRowId } from '../../resetSchedule';
+import type { QuotaBodyProps } from '../../types';
+
+export function ClineQuotaBody({ quota, classes }: QuotaBodyProps<ClineQuotaState>) {
+  const { t, i18n } = useTranslation();
+  const now = useNow();
+  const soonestRowId = useMemo(
+    () => pickUrgentRowId(collectQuotaRowInstants('cline', quota), now),
+    [quota, now]
+  );
+  const windows = quota.windows ?? [];
+
+  if (windows.length === 0) {
+    return <div className={classes.quotaMessage}>{t('cline_quota.empty_data')}</div>;
+  }
+
+  return (
+    <>
+      {windows.map((window, index) => {
+        const remaining = window.remainingPercent;
+        const resetDisplay = buildResetDisplay(
+          window.resetLabel || null,
+          window.resetAtMs,
+          now,
+          i18n.resolvedLanguage
+        );
+        const soon = window.id === soonestRowId;
+        return (
+          <div
+            key={window.id}
+            className={classes.quotaRow}
+            title={soon ? t('quota_management.soonest_row_hint') : undefined}
+          >
+            <div className={classes.quotaRowHeader}>
+              <span className={classes.quotaModel}>{t(window.labelKey)}</span>
+              <div className={classes.quotaMeta}>
+                <span className={classes.quotaPercent}>
+                  {remaining === null ? '--' : `${Math.round(remaining)}%`}
+                </span>
+                {resetDisplay && (
+                  <QuotaResetLabel display={resetDisplay} classes={classes} soon={soon} />
+                )}
+              </div>
+            </div>
+            <QuotaMeter percent={remaining} classes={classes} index={index} />
+          </div>
+        );
+      })}
+    </>
+  );
+}
diff --git a/src/features/quota/providers/cline/data.ts b/src/features/quota/providers/cline/data.ts
new file mode 100644
index 0000000..baaf9e5
--- /dev/null
+++ b/src/features/quota/providers/cline/data.ts
@@ -0,0 +1,72 @@
+import type { TFunction } from 'i18next';
+import type { AuthFileItem, ClineQuotaState, OpenCodeQuotaWindow } from '@/types';
+import { apiCallApi, getApiCallErrorMessage } from '@/services/api';
+import {
+  CLINE_REQUEST_HEADERS,
+  CLINE_USAGE_LIMITS_URL,
+  buildClineQuotaWindows,
+  createStatusError,
+  isClineFile,
+  isDisabledAuthFile,
+  parseClineUsageLimitsPayload,
+} from '@/utils/quota';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import type { QuotaProviderData } from '../types';
+
+export type ClineQuotaData = { windows: OpenCodeQuotaWindow[] };
+
+const mapStatusError = (status: number, fallback: string, t: TFunction) => {
+  if (status === 401) return t('cline_quota.unauthorized');
+  if (status === 403) return t('cline_quota.subscription_required');
+  if (status === 429) return t('cline_quota.rate_limited');
+  if (status >= 500) return t('cline_quota.upstream_unavailable');
+  return fallback;
+};
+
+const fetchClineQuota = async (file: AuthFileItem, t: TFunction): Promise<ClineQuotaData> => {
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) throw new Error(t('cline_quota.missing_auth_index'));
+
+  let result;
+  try {
+    result = await apiCallApi.request({
+      authIndex,
+      method: 'GET',
+      url: CLINE_USAGE_LIMITS_URL,
+      header: { ...CLINE_REQUEST_HEADERS },
+    });
+  } catch (err: unknown) {
+    const message = err instanceof Error ? err.message : t('cline_quota.request_failed');
+    throw createStatusError(t('cline_quota.request_failed_with_message', { message }), undefined);
+  }
+
+  if (result.statusCode < 200 || result.statusCode >= 300) {
+    const fallback = getApiCallErrorMessage(result);
+    throw createStatusError(mapStatusError(result.statusCode, fallback, t), result.statusCode);
+  }
+
+  const payload = parseClineUsageLimitsPayload(result.body ?? result.bodyText);
+  if (!payload) throw new Error(t('cline_quota.invalid_response'));
+  const windows = buildClineQuotaWindows(payload);
+  if (!windows.some((window) => window.usedPercent !== null || window.resetAtMs != null)) {
+    throw new Error(t('cline_quota.empty_data'));
+  }
+  return { windows };
+};
+
+export const CLINE_CONFIG: QuotaProviderData<ClineQuotaState, ClineQuotaData> = {
+  type: 'cline',
+  i18nPrefix: 'cline_quota',
+  filterFn: (file) => isClineFile(file) && !isDisabledAuthFile(file),
+  fetchQuota: fetchClineQuota,
+  storeSelector: (state) => state.clineQuota,
+  storeSetter: 'setClineQuota',
+  buildLoadingState: () => ({ status: 'loading', windows: [] }),
+  buildSuccessState: (data) => ({ status: 'success', windows: data.windows }),
+  buildErrorState: (message, status) => ({
+    status: 'error',
+    windows: [],
+    error: message,
+    errorStatus: status,
+  }),
+};
