diff --git a/src/utils/quota/compat.ts b/src/utils/quota/compat.ts
new file mode 100644
index 0000000..214677f
--- /dev/null
+++ b/src/utils/quota/compat.ts
@@ -0,0 +1,118 @@
+/**
+ * Quota-capable API-key compatibility rows.
+ *
+ * `/auth-files` does not expose compatibility-provider base URLs or per-key
+ * credentials, so quota cards that target those pools need synthesized rows
+ * carrying `auth_index` and `baseUrl`.
+ */
+
+import type { AuthFileItem } from '@/types';
+import { getCompatCardForBaseUrl } from './custom';
+
+type OpenAICompatProviderLike = {
+  name?: string;
+  baseUrl?: string;
+  disabled?: boolean;
+  apiKeyEntries?: Array<{ authIndex?: string; apiKey?: string }>;
+};
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  Boolean(value) && typeof value === 'object' && !Array.isArray(value);
+
+const readString = (value: unknown): string =>
+  typeof value === 'string' ? value.trim() : value == null ? '' : String(value).trim();
+
+const readBaseUrl = (record: Record<string, unknown>): string => {
+  for (const candidate of [
+    record.baseUrl,
+    record['base-url'],
+    record.base_url,
+    record.BaseURL,
+  ]) {
+    const value = readString(candidate);
+    if (value) return value;
+  }
+  return '';
+};
+
+const readAuthIndex = (record: Record<string, unknown>): string =>
+  readString(record.authIndex ?? record['auth_index']);
+
+/** Attach compatibility-provider base URLs onto auth-file rows by auth_index. */
+export function attachCompatBaseUrls(
+  files: AuthFileItem[],
+  compatProviders: OpenAICompatProviderLike[]
+): AuthFileItem[] {
+  const byAuthIndex = new Map<string, string>();
+  for (const provider of compatProviders) {
+    const baseUrl = readString(provider.baseUrl);
+    if (!baseUrl) continue;
+    for (const entry of provider.apiKeyEntries ?? []) {
+      const authIndex = readString(entry.authIndex);
+      if (!authIndex) continue;
+      byAuthIndex.set(authIndex, baseUrl);
+    }
+  }
+
+  if (byAuthIndex.size === 0) return files;
+
+  return files.map((file) => {
+    const existing = readBaseUrl(file as unknown as Record<string, unknown>);
+    if (existing) return file;
+    const authIndex = readAuthIndex(file as unknown as Record<string, unknown>);
+    if (!authIndex) return file;
+    const baseUrl = byAuthIndex.get(authIndex);
+    if (!baseUrl) return file;
+    return { ...file, baseUrl, 'base-url': baseUrl };
+  });
+}
+
+/**
+ * Synthesize quota-capable rows for compatibility providers that a registered
+ * card claims via `matchesBaseUrl` but that `/auth-files` does not list.
+ */
+export function mergeQuotaCompatAuthFiles(
+  files: AuthFileItem[],
+  compatProviders: OpenAICompatProviderLike[]
+): AuthFileItem[] {
+  const withBase = attachCompatBaseUrls(files, compatProviders);
+  const existingAuthIndexes = new Set<string>();
+  for (const file of withBase) {
+    const authIndex = readAuthIndex(file as unknown as Record<string, unknown>);
+    if (authIndex) existingAuthIndexes.add(authIndex);
+  }
+
+  const synthesized: AuthFileItem[] = [];
+  for (const provider of compatProviders) {
+    const baseUrl = readString(provider.baseUrl);
+    if (!baseUrl || provider.disabled === true) continue;
+    const card = getCompatCardForBaseUrl(baseUrl);
+    if (!card) continue;
+    const providerLike: unknown = provider;
+    const providerName = isRecord(providerLike)
+      ? readString(providerLike.name)
+      : '';
+    const label = providerName || card.compatTitle || card.title;
+    for (const entry of provider.apiKeyEntries ?? []) {
+      const authIndex = readString(entry.authIndex);
+      if (!authIndex || existingAuthIndexes.has(authIndex)) continue;
+      synthesized.push({
+        name: `openai-compat:${label}:${authIndex}`,
+        authIndex,
+        auth_index: authIndex,
+        baseUrl,
+        'base-url': baseUrl,
+        provider: 'openai-compatible',
+        type: 'openai-compatible',
+        label,
+        disabled: false,
+        source: 'openai-compatibility',
+        runtime_only: true,
+        runtimeOnly: true,
+      } as AuthFileItem);
+      existingAuthIndexes.add(authIndex);
+    }
+  }
+
+  return synthesized.length > 0 ? [...withBase, ...synthesized] : withBase;
+}
