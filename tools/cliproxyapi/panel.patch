diff --git a/src/features/quota/providers/custom/CustomQuotaBody.tsx b/src/features/quota/providers/custom/CustomQuotaBody.tsx
new file mode 100644
index 0000000..fb605e4
--- /dev/null
+++ b/src/features/quota/providers/custom/CustomQuotaBody.tsx
@@ -0,0 +1,58 @@
+import { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { CustomQuotaState } from '@/types';
+import { buildResetDisplay } from '@/utils/quota';
+import { useNow } from '@/hooks/useNow';
+import { QuotaMeter } from '../../components/QuotaMeter';
+import { QuotaResetLabel } from '../../components/QuotaResetLabel';
+import { collectQuotaRowInstants, pickUrgentRowId } from '../../resetSchedule';
+import type { QuotaBodyProps } from '../../types';
+
+export function CustomQuotaBody({ quota, classes }: QuotaBodyProps<CustomQuotaState>) {
+  const { t, i18n } = useTranslation();
+  const now = useNow();
+  const soonestRowId = useMemo(
+    () => pickUrgentRowId(collectQuotaRowInstants('custom', quota), now),
+    [quota, now]
+  );
+  const windows = quota.windows ?? [];
+
+  if (windows.length === 0) {
+    return <div className={classes.quotaMessage}>{t('custom_quota.empty_data')}</div>;
+  }
+
+  return (
+    <>
+      {windows.map((window, index) => {
+        const remaining = window.remainingPercent;
+        const resetDisplay = buildResetDisplay(
+          window.resetLabel || null,
+          window.resetAtMs,
+          now,
+          i18n.resolvedLanguage
+        );
+        const soon = window.id === soonestRowId;
+        return (
+          <div
+            key={window.id}
+            className={classes.quotaRow}
+            title={soon ? t('quota_management.soonest_row_hint') : undefined}
+          >
+            <div className={classes.quotaRowHeader}>
+              <span className={classes.quotaModel}>{window.label}</span>
+              <div className={classes.quotaMeta}>
+                <span className={classes.quotaPercent}>
+                  {remaining === null ? '--' : `${Math.round(remaining)}%`}
+                </span>
+                {resetDisplay && (
+                  <QuotaResetLabel display={resetDisplay} classes={classes} soon={soon} />
+                )}
+              </div>
+            </div>
+            <QuotaMeter percent={remaining} classes={classes} index={index} />
+          </div>
+        );
+      })}
+    </>
+  );
+}
diff --git a/src/features/quota/providers/custom/data.ts b/src/features/quota/providers/custom/data.ts
new file mode 100644
index 0000000..c7bcb11
--- /dev/null
+++ b/src/features/quota/providers/custom/data.ts
@@ -0,0 +1,86 @@
+/**
+ * Generic quota provider: all cards defined by `@/utils/quota/custom/cards`.
+ */
+
+import type { TFunction } from 'i18next';
+import type { AuthFileItem, CustomQuotaState, CustomQuotaWindow } from '@/types';
+import { apiCallApi, getApiCallErrorMessage } from '@/services/api';
+import { createStatusError, isDisabledAuthFile } from '@/utils/quota';
+import { getQuotaCard } from '@/utils/quota/custom';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import type { QuotaProviderData } from '../types';
+
+export type CustomQuotaData = {
+  cardId: string;
+  cardTitle: string;
+  windows: CustomQuotaWindow[];
+};
+
+const mapStatusError = (status: number, fallback: string, t: TFunction) => {
+  if (status === 401) return t('custom_quota.unauthorized');
+  if (status === 403) return t('custom_quota.subscription_required');
+  if (status === 429) return t('custom_quota.rate_limited');
+  if (status >= 500) return t('custom_quota.upstream_unavailable');
+  return fallback;
+};
+
+const fetchCustomQuota = async (
+  file: AuthFileItem,
+  t: TFunction
+): Promise<CustomQuotaData> => {
+  const card = getQuotaCard(file);
+  if (!card) throw new Error(t('custom_quota.no_card'));
+
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) throw new Error(t('custom_quota.missing_auth_index'));
+
+  let result;
+  try {
+    result = await apiCallApi.request({ authIndex, ...card.request(file) });
+  } catch (err: unknown) {
+    const message = err instanceof Error ? err.message : t('custom_quota.request_failed');
+    throw createStatusError(
+      t('custom_quota.request_failed_with_message', { message }),
+      undefined
+    );
+  }
+
+  if (result.statusCode < 200 || result.statusCode >= 300) {
+    const fallback = getApiCallErrorMessage(result);
+    throw createStatusError(
+      mapStatusError(result.statusCode, fallback, t),
+      result.statusCode
+    );
+  }
+
+  const windows = card.parse(result.body ?? result.bodyText);
+  if (!windows || windows.length === 0) {
+    throw new Error(t('custom_quota.invalid_response'));
+  }
+  if (!windows.some((window) => window.remainingPercent !== null || window.resetAtMs != null)) {
+    throw new Error(t('custom_quota.empty_data'));
+  }
+  return { cardId: card.id, cardTitle: card.title, windows };
+};
+
+export const CUSTOM_CONFIG: QuotaProviderData<CustomQuotaState, CustomQuotaData> = {
+  type: 'custom',
+  i18nPrefix: 'custom_quota',
+  filterFn: (file) => getQuotaCard(file) !== undefined && !isDisabledAuthFile(file),
+  fetchQuota: fetchCustomQuota,
+  storeSelector: (state) => state.customQuota,
+  storeSetter: 'setCustomQuota',
+  buildLoadingState: () => ({ status: 'loading', windows: [] }),
+  buildSuccessState: (data) => ({
+    status: 'success',
+    windows: data.windows,
+    cardId: data.cardId,
+    cardTitle: data.cardTitle,
+  }),
+  buildErrorState: (message, status) => ({
+    status: 'error',
+    windows: [],
+    error: message,
+    errorStatus: status,
+  }),
+};
