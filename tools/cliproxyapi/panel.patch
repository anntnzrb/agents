index 0000000..cc950cf
--- /dev/null
+++ b/src/utils/quota/custom/match.ts
@@ -0,0 +1,21 @@
+/**
+ * Quota-card lookup helpers.
+ */
+
+import type { AuthFileItem } from '@/types';
+import { QUOTA_CARDS } from './cards';
+import type { QuotaCard } from './types';
+
+/** First registered card that matches an auth-file row, if any. */
+export const getQuotaCard = (file: AuthFileItem): QuotaCard | undefined =>
+  QUOTA_CARDS.find((card) => card.matches(file));
+
+/** Cards that can serve API-key compatibility providers. */
+export const getCompatCards = (): readonly QuotaCard[] =>
+  QUOTA_CARDS.filter((card) => card.matchesBaseUrl !== undefined);
+
+/** Card responsible for a compatibility provider base URL, if any. */
+export const getCompatCardForBaseUrl = (baseUrl: string): QuotaCard | undefined =>
+  getCompatCards().find((card) => card.matchesBaseUrl?.(baseUrl) === true);
+
+export type { QuotaCard };
diff --git a/src/utils/quota/custom/types.ts b/src/utils/quota/custom/types.ts
new file mode 100644
index 0000000..af10a5a
--- /dev/null
+++ b/src/utils/quota/custom/types.ts
@@ -0,0 +1,39 @@
+/**
+ * Declarative quota-card contract.
+ *
+ * Cards are data, not code: the panel ships one generic `custom` provider that
+ * consumes this contract, so adding a provider card means adding one object to
+ * `cards.ts` (see `tools/cliproxyapi/quota-cards.ts` in the agents repository).
+ */
+
+import type { CustomQuotaWindow } from '@/types';
+import type { AuthFileItem } from '@/types';
+
+export interface QuotaCardRequest {
+  method: string;
+  url: string;
+  /** `$TOKEN$` is replaced with the selected credential by the gateway. */
+  header?: Record<string, string>;
+  data?: string;
+}
+
+export interface QuotaCard {
+  /** Stable id; used for state and DOM keys. */
+  id: string;
+  /** Card title (provider name) shown on the quota page. */
+  title: string;
+  /** Auth-file rows this card serves. */
+  matches: (file: AuthFileItem) => boolean;
+  /**
+   * Base-URL matcher for API-key compatibility providers. Cards with this
+   * field get synthetic rows when the gateway lists the provider but not its
+   * per-key credentials.
+   */
+  matchesBaseUrl?: (baseUrl: string) => boolean;
+  /** Title used for synthesized compatibility rows. Defaults to `title`. */
+  compatTitle?: string;
+  /** Upstream request; `$TOKEN$` in headers or body is substituted by the gateway. */
+  request: (file: AuthFileItem) => QuotaCardRequest;
+  /** Map an api-call payload into windows; null or empty means "no data". */
+  parse: (payload: unknown) => CustomQuotaWindow[] | null;
+}
