new file mode 100644
index 0000000..73b6bbd
--- /dev/null
+++ b/tests/clineQuota.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, test } from 'bun:test';
+import type { AuthFileItem } from '@/types';
+import { QUOTA_TAB_ORDER } from '@/features/quota/constants';
+import { resolveQuotaProviderType } from '@/features/quota/logic';
+import { QUOTA_ADAPTERS } from '@/features/quota/providers';
+import {
+  buildClineQuotaWindows,
+  isClineBaseUrl,
+  isClineFile,
+  mergeClineCompatAuthFiles,
+  parseClineUsageLimitsPayload,
+} from '@/utils/quota/cline';
+
+const file = (name: string, extra: Partial<AuthFileItem> = {}): AuthFileItem =>
+  ({ name, ...extra }) as AuthFileItem;
+
+describe('ClinePass quota provider', () => {
+  test('matches only the official Cline API base URL', () => {
+    expect(isClineBaseUrl('https://api.cline.bot/api/v1')).toBe(true);
+    expect(isClineBaseUrl('https://api.cline.bot/api/v1/')).toBe(true);
+    expect(isClineBaseUrl('https://api.cline.bot/v1')).toBe(false);
+    expect(isClineBaseUrl('https://api.cline.bot.example.com/api/v1')).toBe(false);
+    expect(isClineBaseUrl('https://example.com/api/v1')).toBe(false);
+  });
+
+  test('parses official five-hour, weekly, and monthly limits', () => {
+    const payload = parseClineUsageLimitsPayload({
+      data: {
+        limits: [
+          { type: 'five_hour', percentUsed: 75, resetsAt: '2026-08-17T08:23:52Z' },
+          { type: 'weekly', percentUsed: 30, resetsAt: '2026-08-24T03:23:52Z' },
+          { type: 'monthly', percentUsed: 15, resetsAt: '2026-09-16T03:23:52Z' },
+        ],
+      },
+      success: true,
+    });
+    expect(payload).not.toBeNull();
+    const windows = buildClineQuotaWindows(payload!);
+    expect(windows.map((window) => window.id)).toEqual(['5h', 'weekly', 'monthly']);
+    expect(windows.map((window) => window.usedPercent)).toEqual([75, 30, 15]);
+    expect(windows.map((window) => window.remainingPercent)).toEqual([25, 70, 85]);
+    expect(windows.every((window) => typeof window.resetAtMs === 'number')).toBe(true);
+  });
+
+  test('rejects malformed usage payloads', () => {
+    expect(parseClineUsageLimitsPayload(null)).toBeNull();
+    expect(parseClineUsageLimitsPayload({})).toBeNull();
+    expect(parseClineUsageLimitsPayload({ data: { limits: [] } })).toBeNull();
+  });
+
+  test('synthesizes a runtime-only row and registers the provider', () => {
+    const merged = mergeClineCompatAuthFiles(
+      [],
+      [
+        {
+          name: 'cline-pass',
+          baseUrl: 'https://api.cline.bot/api/v1',
+          apiKeyEntries: [{ authIndex: 'cline-key-1' }],
+        },
+      ]
+    );
+    expect(merged).toHaveLength(1);
+    expect(merged[0]).toMatchObject({
+      name: 'openai-compat:cline-pass:cline-key-1',
+      authIndex: 'cline-key-1',
+      runtime_only: true,
+    });
+    expect(isClineFile(merged[0]!)).toBe(true);
+    expect(resolveQuotaProviderType(merged[0]!)).toBe('cline');
+    expect(QUOTA_TAB_ORDER).toContain('cline');
+    expect(QUOTA_ADAPTERS.cline.type).toBe('cline');
+  });
+
+  test('does not classify unrelated compatibility providers as Cline', () => {
+    expect(
+      isClineFile(
+        file('openrouter', {
+          provider: 'openai-compatible',
+          baseUrl: 'https://openrouter.ai/api/v1',
+        })
+      )
+    ).toBe(false);
+  });
+});
