diff --git a/src/features/quota/QuotaPoolPage.module.scss b/src/features/quota/QuotaPoolPage.module.scss
new file mode 100644
index 0000000..70dcc02
--- /dev/null
+++ b/src/features/quota/QuotaPoolPage.module.scss
@@ -0,0 +1,188 @@
+@use '../../styles/mixins' as *;
+
+/* Quota pool: one card per provider, one stacked meter per quota window.
+ * Card recipe mirrors QuotaCard; telemetry stays mono + tabular-nums. */
+
+.page {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  width: 100%;
+  min-width: 0;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
+  gap: 14px;
+  align-items: start;
+}
+
+.errorBanner {
+  padding: 10px 14px;
+  border-radius: 10px;
+  border: 1px solid color-mix(in srgb, var(--viz-failure) 40%, transparent);
+  color: var(--viz-failure);
+  font-size: 13px;
+}
+
+.card {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 15px 16px;
+  border-radius: 14px;
+  border: 1px solid var(--border-color);
+  background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
+}
+
+.head {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  min-width: 0;
+}
+
+.iconWrap {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 26px;
+  height: 26px;
+  border-radius: 8px;
+  background: color-mix(in srgb, var(--bg-tertiary) 60%, transparent);
+}
+
+.icon {
+  width: 16px;
+  height: 16px;
+  object-fit: contain;
+  display: block;
+}
+
+.iconFallback {
+  font-size: 11px;
+  font-weight: 700;
+  color: var(--text-secondary);
+}
+
+.title {
+  min-width: 0;
+  font-size: 14px;
+  font-weight: 650;
+  color: var(--text-primary);
+  @include text-ellipsis;
+}
+
+.accounts {
+  margin-left: auto;
+  flex-shrink: 0;
+  font-family: $font-mono;
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-tertiary);
+}
+
+.windows {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.row {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.rowHeader {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 12px;
+  min-width: 0;
+}
+
+.rowLabel {
+  min-width: 0;
+  font-size: 12.5px;
+  color: var(--text-secondary);
+  @include text-ellipsis;
+}
+
+.rowValue {
+  flex-shrink: 0;
+  font-family: $font-mono;
+  font-size: 13px;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+.rowCapacity {
+  font-weight: 500;
+  color: var(--text-tertiary);
+}
+
+/* One slot per account: the track is literally N × 100%. */
+.stack {
+  display: flex;
+  gap: 3px;
+}
+
+.slot {
+  flex: 1 1 0;
+  min-width: 0;
+  height: 8px;
+  border-radius: $radius-full;
+  background: color-mix(in srgb, var(--text-primary) 8%, transparent);
+  overflow: hidden;
+}
+
+.slotFill {
+  height: 100%;
+  border-radius: $radius-full;
+  transition: width 360ms var(--ease-out-strong, ease);
+}
+
+.fillHigh {
+  background: var(--viz-success);
+}
+
+.fillMedium {
+  background: var(--quota-medium-color);
+}
+
+.fillLow {
+  background: var(--viz-failure);
+}
+
+.valueHigh {
+  color: var(--viz-success);
+}
+
+.valueMedium {
+  color: var(--quota-medium-color);
+}
+
+.valueLow {
+  color: var(--viz-failure);
+}
+
+.note {
+  margin: 0;
+  font-size: 12px;
+  color: var(--text-tertiary);
+}
+
+.failed {
+  margin: 0;
+  font-size: 12px;
+  color: var(--viz-failure);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .slotFill {
+    transition: none;
+  }
+}
diff --git a/src/features/quota/QuotaPoolPage.tsx b/src/features/quota/QuotaPoolPage.tsx
new file mode 100644
index 0000000..a935594
--- /dev/null
+++ b/src/features/quota/QuotaPoolPage.tsx
@@ -0,0 +1,325 @@
+/**
+ * Quota pool page: each provider's credentials stacked into one capacity.
+ *
+ * Shares the quota cache with the quota page, so either page's loads show up
+ * in both. Unlike the quota page, opening this one fetches every credential
+ * that has no cached state yet — a pool with unloaded accounts is meaningless.
+ */
+
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { authFilesApi, providersApi } from '@/services/api';
+import { EmptyState } from '@/components/ui/EmptyState';
+import { IconRefreshCw } from '@/components/ui/icons';
+import { Skeleton } from '@/components/ui/Skeleton';
+import { useHeaderRefresh } from '@/hooks/useHeaderRefresh';
+import { useRevealGroup } from '@/hooks/motion';
+import { useAuthStore, useQuotaStore, useThemeStore } from '@/stores';
+import type { AuthFileItem, ResolvedTheme } from '@/types';
+import { getQuotaCacheKey } from '@/utils/quota/identity';
+import { mergeQuotaCompatAuthFiles } from '@/utils/quota';
+import {
+  getAuthFileIcon,
+  getThemeSurfaceIconBackground,
+  getTypeLabel,
+  isThemeSurfaceIconProvider,
+} from '@/features/authFiles/constants';
+import {
+  QUOTA_PROGRESS_HIGH_THRESHOLD,
+  QUOTA_PROGRESS_MEDIUM_THRESHOLD,
+} from './components/QuotaMeter';
+import { classifyQuotaFiles, type QuotaFileEntry } from './logic';
+import type { QuotaCardState } from './providers';
+import type { QuotaProviderType, QuotaStore } from './providers/types';
+import { buildQuotaPool, type QuotaPoolGroup, type QuotaPoolWindow } from './quotaPoolModel';
+import { useQuotaBatchLoader } from './hooks/useQuotaBatchLoader';
+import headerStyles from './components/QuotaHeader.module.scss';
+import styles from './QuotaPoolPage.module.scss';
+
+const SKELETON_CARD_COUNT = 3;
+
+const STORE_KEYS: Record<QuotaProviderType, keyof QuotaStore> = {
+  antigravity: 'antigravityQuota',
+  claude: 'claudeQuota',
+  codex: 'codexQuota',
+  devin: 'devinQuota',
+  kimi: 'kimiQuota',
+  meta: 'metaQuota',
+  xai: 'xaiQuota',
+  custom: 'customQuota',
+};
+
+type Level = 'High' | 'Medium' | 'Low';
+
+const levelOf = (percent: number | null): Level | null =>
+  percent === null
+    ? null
+    : percent >= QUOTA_PROGRESS_HIGH_THRESHOLD
+      ? 'High'
+      : percent >= QUOTA_PROGRESS_MEDIUM_THRESHOLD
+        ? 'Medium'
+        : 'Low';
+
+const levelClass = (prefix: 'value' | 'fill', percent: number | null) => {
+  const level = levelOf(percent);
+  return level ? styles[`${prefix}${level}`] : '';
+};
+
+const formatPercent = (value: number) => `${Math.round(value)}%`;
+
+export function QuotaPoolPage() {
+  const { t } = useTranslation();
+  const connectionStatus = useAuthStore((state) => state.connectionStatus);
+  const resolvedTheme: ResolvedTheme = useThemeStore((state) => state.resolvedTheme);
+  const sessionGeneration = useQuotaStore((state) => state.cacheGeneration);
+  const revealRef = useRevealGroup<HTMLDivElement>();
+
+  const [files, setFiles] = useState<AuthFileItem[]>([]);
+  const [filesGeneration, setFilesGeneration] = useState<number | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const listRequestRef = useRef(0);
+  const disableControls = connectionStatus !== 'connected';
+
+  const loadFiles = useCallback(async () => {
+    const requestId = ++listRequestRef.current;
+    if (connectionStatus !== 'connected') {
+      setFiles([]);
+      setFilesGeneration(null);
+      setLoading(false);
+      return;
+    }
+    const isCurrent = () =>
+      requestId === listRequestRef.current &&
+      sessionGeneration === useQuotaStore.getState().cacheGeneration;
+    setLoading(true);
+    setError('');
+    try {
+      const [data, openaiCompat] = await Promise.all([
+        authFilesApi.list(),
+        providersApi.getQuotaOpenAIProviders().catch(() => []),
+      ]);
+      if (!isCurrent()) return;
+      setFiles(mergeQuotaCompatAuthFiles(data?.files || [], openaiCompat || []));
+      setFilesGeneration(sessionGeneration);
+    } catch (err: unknown) {
+      if (!isCurrent()) return;
+      setError(err instanceof Error ? err.message : t('notification.refresh_failed'));
+    } finally {
+      if (isCurrent()) setLoading(false);
+    }
+  }, [connectionStatus, sessionGeneration, t]);
+
+  useHeaderRefresh(loadFiles);
+
+  useEffect(() => {
+    void loadFiles();
+    return () => {
+      listRequestRef.current += 1;
+    };
+  }, [loadFiles]);
+
+  const quotaStore = useQuotaStore() as unknown as QuotaStore;
+  const quotaFor = useCallback(
+    (entry: QuotaFileEntry): QuotaCardState | undefined =>
+      (quotaStore[STORE_KEYS[entry.type]] as Record<string, QuotaCardState>)[
+        getQuotaCacheKey(entry.file)
+      ],
+    [quotaStore]
+  );
+
+  const entries = useMemo(() => classifyQuotaFiles(files), [files]);
+  const pools = useMemo(() => buildQuotaPool(entries, quotaFor), [entries, quotaFor]);
+
+  const { batchLoading, loadQuota } = useQuotaBatchLoader();
+  const listReady = !loading && !error && filesGeneration === sessionGeneration;
+
+  // Fetch each credential with no cached state once per file list.
+  const autoLoadedRef = useRef<AuthFileItem[] | null>(null);
+  useEffect(() => {
+    if (disableControls || !listReady || autoLoadedRef.current === files) return;
+    autoLoadedRef.current = files;
+    const missing = entries.filter((entry) => (quotaFor(entry)?.status ?? 'idle') === 'idle');
+    void loadQuota(missing);
+  }, [disableControls, entries, files, listReady, loadQuota, quotaFor]);
+
+  const handleRefreshAll = useCallback(() => {
+    if (disableControls || !listReady) return;
+    void loadQuota(entries);
+  }, [disableControls, entries, listReady, loadQuota]);
+
+  // Count credentials, not pools: a hidden pool's accounts still loaded.
+  const loadedCount = entries.filter((entry) => quotaFor(entry)?.status === 'success').length;
+  const failedCount = entries.filter((entry) => quotaFor(entry)?.status === 'error').length;
+  const refreshing = loading || batchLoading;
+
+  return (
+    <div className={styles.page} ref={revealRef}>
+      <header className={headerStyles.header}>
+        <div className={headerStyles.copy}>
+          <h1 className={headerStyles.title} data-reveal>
+            {t('quota_pool.title')}
+          </h1>
+          <p className={headerStyles.meta} data-reveal>
+            <span className={headerStyles.metaTotal}>
+              {t('quota_management.meta_credentials', { count: entries.length })}
+            </span>
+            <span className={headerStyles.metaDot} aria-hidden="true">
+              ·
+            </span>
+            <span className={loadedCount > 0 ? headerStyles.metaLoaded : headerStyles.metaMuted}>
+              {t('quota_management.meta_loaded', { count: loadedCount })}
+            </span>
+            {failedCount > 0 && (
+              <>
+                <span className={headerStyles.metaDot} aria-hidden="true">
+                  ·
+                </span>
+                <span className={headerStyles.metaAttention}>
+                  {t('quota_management.meta_attention', { count: failedCount })}
+                </span>
+              </>
+            )}
+          </p>
+        </div>
+        <div className={headerStyles.actions} data-reveal>
+          <button
+            type="button"
+            className={headerStyles.primaryAction}
+            onClick={handleRefreshAll}
+            disabled={disableControls || refreshing}
+          >
+            <IconRefreshCw size={14} className={refreshing ? headerStyles.spinning : undefined} />
+            {t('quota_management.refresh_all_credentials')}
+          </button>
+        </div>
+      </header>
+
+      {error && (
+        <div className={styles.errorBanner} role="alert">
+          {error}
+        </div>
+      )}
+
+      {loading ? (
+        <div className={styles.grid} aria-hidden="true">
+          {Array.from({ length: SKELETON_CARD_COUNT }, (_, index) => (
+            <Skeleton key={index} height={168} rounded={14} />
+          ))}
+        </div>
+      ) : pools.length === 0 ? (
+        <EmptyState
+          title={t('quota_management.empty_title')}
+          description={t('quota_management.empty_desc')}
+        />
+      ) : (
+        <div className={styles.grid}>
+          {pools.map((pool) => (
+            <PoolCard key={pool.id} pool={pool} resolvedTheme={resolvedTheme} busy={batchLoading} />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function PoolCard({
+  pool,
+  resolvedTheme,
+  busy,
+}: {
+  pool: QuotaPoolGroup;
+  resolvedTheme: ResolvedTheme;
+  busy: boolean;
+}) {
+  const { t } = useTranslation();
+  const typeLabel = getTypeLabel(t, pool.provider);
+  const title = pool.title ?? typeLabel;
+  const iconSrc = getAuthFileIcon(pool.provider, resolvedTheme);
+  const pending = pool.accounts - pool.loaded - pool.failed;
+
+  return (
+    <article className={styles.card}>
+      <header className={styles.head}>
+        <span
+          className={styles.iconWrap}
+          title={typeLabel}
+          style={
+            isThemeSurfaceIconProvider(pool.provider)
+              ? { background: getThemeSurfaceIconBackground(resolvedTheme) }
+              : undefined
+          }
+        >
+          {iconSrc ? (
+            <img src={iconSrc} alt="" className={styles.icon} />
+          ) : (
+            <span className={styles.iconFallback}>{title.slice(0, 1).toUpperCase()}</span>
+          )}
+        </span>
+        <span className={styles.title}>{title}</span>
+        <span className={styles.accounts}>
+          {t('quota_pool.accounts', { count: pool.accounts })}
+        </span>
+      </header>
+
+      {pool.windows.length > 0 ? (
+        <div className={styles.windows}>
+          {pool.windows.map((window) => (
+            <PoolWindowRow key={window.key} window={window} />
+          ))}
+        </div>
+      ) : busy && pending > 0 ? (
+        <Skeleton height={44} rounded={8} />
+      ) : (
+        <p className={styles.note}>{t('quota_pool.no_data')}</p>
+      )}
+
+      {pool.failed > 0 && (
+        <p className={styles.failed}>{t('quota_pool.failed', { count: pool.failed })}</p>
+      )}
+    </article>
+  );
+}
+
+function PoolWindowRow({ window }: { window: QuotaPoolWindow }) {
+  const { t } = useTranslation();
+  const label = window.labelKey ? t(window.labelKey, window.labelParams) : window.label;
+  const pooledPercent = window.capacity > 0 ? (window.remaining / window.capacity) * 100 : null;
+
+  return (
+    <div className={styles.row}>
+      <div className={styles.rowHeader}>
+        <span className={styles.rowLabel}>{label}</span>
+        <span className={styles.rowValue}>
+          <span className={levelClass('value', pooledPercent)}>
+            {formatPercent(window.remaining)}
+          </span>
+          <span className={styles.rowCapacity}> / {formatPercent(window.capacity)}</span>
+        </span>
+      </div>
+      <div
+        className={styles.stack}
+        role="img"
+        aria-label={`${label}: ${formatPercent(window.remaining)} / ${formatPercent(window.capacity)}`}
+      >
+        {window.slots.map((slot, index) => (
+          <div
+            key={index}
+            className={styles.slot}
+            title={`${slot.name}: ${slot.remaining === null ? '—' : formatPercent(slot.remaining)}`}
+          >
+            <div
+              className={`${styles.slotFill} ${levelClass('fill', slot.remaining)}`}
+              style={{ width: `${slot.remaining ?? 0}%` }}
+            />
+          </div>
+        ))}
+      </div>
+      {window.reporting < window.slots.length && (
+        <span className={styles.note}>
+          {t('quota_pool.reporting', { count: window.reporting, total: window.slots.length })}
+        </span>
+      )}
+    </div>
+  );
+}
