{
  "$schema": "https://opencode.ai/config.json",

  /* **************************************************************************
   * PLUGINS
   * ************************************************************************ */
  // "plugin": [],

  /* **************************************************************************
   * PROVIDERS
   * ************************************************************************ */
  // "provider": {},

  /* **************************************************************************
   * BINDS
   * ************************************************************************ */
  "keybinds": {
    "leader": "ctrl+x",
    "session_compact": "none",
    "session_share": "none",
  },

  /* **************************************************************************
   * PERMISSIONS
   * ************************************************************************ */
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      // python
      "python *": "deny",
      "python3 *": "deny",
      "uv *": "allow",

      // git
      "git merge *": "ask",
      "git pull *": "ask",
      "git push *": "ask",

      // `gh`
      "gh issue close *": "ask",
      "gh issue comment *": "ask",
      "gh issue create *": "ask",
      "gh issue delete *": "ask",
      "gh issue edit *": "ask",
      "gh pr close *": "ask",
      "gh pr comment *": "ask",
      "gh pr create *": "ask",
      "gh pr edit *": "ask",
      "gh pr merge *": "ask",
      "gh pr review *": "ask",
      "gh repo delete *": "ask",

      // allow all commands in ~/.config/opencode
      "~/.config/opencode/*": "allow",
    },
    "external_directory": {
      "*": "ask",
      "~/.config/opencode": "allow",
      "~/.config/opencode/*": "allow",
    },
  },

  /* **************************************************************************
   * MISC
   * ************************************************************************ */
  "default_agent": "build",
  "autoupdate": false,
  "share": "manual",
  "experimental": {
    "disable_paste_summary": true,
    "continue_loop_on_deny": true,
  },
}
