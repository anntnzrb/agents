{
  "$schema": "https://opencode.ai/config.json",

  /* **************************************************************************
   * MODELS
   * ************************************************************************ */

  // "small_model": "github-copilot/gemini-3-flash-preview",

  /* **************************************************************************
   * PLUGINS
   * ************************************************************************ */

  // "plugin": [],

  /* **************************************************************************
   * PROVIDERS
   * ************************************************************************ */

  // "provider": {},

  "default_agent": "build",

  "agent": {
    "plan": {
      "disable": true,
    },
  },

  /* **************************************************************************
   * PERMISSIONS
   * ************************************************************************ */

  "permission": {
    "edit": "allow",
    "external_directory": {
      "*": "allow",
    },
    "bash": {
      // python
      "python *": "deny",
      "python3 *": "deny",
      "uv *": "allow",

      // git
      "git merge *": "ask",
      "git pull *": "ask",
      "git push *": "ask",
    },
  },

  /* **************************************************************************
   * SERVER
   * ************************************************************************ */

  // "server": {
  //   "hostname": "0.0.0.0",
  //   "port": 4096,
  //   "mdns": false,
  // },

  /* **************************************************************************
   * MISC
   * ************************************************************************ */

  "autoupdate": false,
  "share": "manual",
  "formatter": false,
  "lsp": false,
}
