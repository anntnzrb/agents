{
  // Generic agent guardrails policy.
  // Add more rules here without touching extension code.
  "version": 1,
  "skillBindings": {
    "python-tooling": {
      "requiresSkill": "python",
      "requiredWorkflow": "Use uv workflow (`uv run`, `uv add`, `uv run --with`) and avoid raw python/pip/env tooling.",
    },
  },
  "agentBash": {
    "rules": [
      {
        "id": "no-python",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": [
            "python",
            "python2",
            "python3",
            "pythonw",
            "pythonw2",
            "pythonw3",
            "py",
            "pypy",
            "pypy3",
          ],
          "patterns": [
            "^pythonw?(?:[23])?(?:\\.\\d+)*(?:\\.exe)?$",
            "^py(?:\\.exe)?$",
            "^pypy(?:3)?(?:\\.exe)?$",
          ],
        },
        "action": {
          "type": "block",
          "message": "python/python3 is disabled. Use uv-based Python workflow.",
          "requiresBinding": "python-tooling",
        },
      },
      {
        "id": "no-pip",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": ["pip", "pip2", "pip3", "pipx"],
          "patterns": [
            "^pip(?:[23])?(?:\\.\\d+)*(?:\\.exe)?$",
            "^pipx(?:\\.exe)?$",
          ],
        },
        "action": {
          "type": "block",
          "message": "pip/pip3 is disabled. Use uv-based Python workflow.",
          "requiresBinding": "python-tooling",
        },
      },
      {
        "id": "no-python-env-tools",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": [
            "conda",
            "hatch",
            "mamba",
            "pdm",
            "pipenv",
            "poetry",
            "rye",
            "virtualenv",
          ],
          "patterns": [
            "^(?:conda|hatch|mamba|pdm|pipenv|poetry|rye|virtualenv)(?:\\.exe)?$",
          ],
        },
        "action": {
          "type": "block",
          "message": "Python env/package tooling is disabled. Use uv-based Python workflow.",
          "requiresBinding": "python-tooling",
        },
      },
      {
        "id": "no-python-m-pip",
        "match": {
          "type": "regex",
          "pattern": "\\b(?:pythonw?(?:[23])?(?:\\.\\d+)*|py|pypy3?)\\b[^\\n;|&]*(?:\\s-m\\s*pip\\b|\\s-mpip\\b)",
          "flags": "i",
        },
        "action": {
          "type": "block",
          "message": "`python -m pip` is disabled. Use uv-based Python workflow.",
          "requiresBinding": "python-tooling",
        },
      },
      {
        "id": "no-python-m-venv",
        "match": {
          "type": "regex",
          "pattern": "\\b(?:pythonw?(?:[23])?(?:\\.\\d+)*|py|pypy3?)\\b[^\\n;|&]*(?:\\s-m\\s*venv\\b|\\s-mvenv\\b)",
          "flags": "i",
        },
        "action": {
          "type": "block",
          "message": "`python -m venv` is disabled. Use uv-based Python workflow.",
          "requiresBinding": "python-tooling",
        },
      },
      {
        "id": "no-python-m-py-compile",
        "match": {
          "type": "regex",
          "pattern": "\\b(?:pythonw?(?:[23])?(?:\\.\\d+)*|py|pypy3?)\\b[^\\n;|&]*(?:\\s-m\\s*py_compile\\b|\\s-mpy_compile\\b)",
          "flags": "i",
        },
        "action": {
          "type": "block",
          "message": "`python -m py_compile` is disabled. Use uv-based Python workflow.",
          "requiresBinding": "python-tooling",
        },
      },
      {
        "id": "prefer-native-file-discovery-rg-files",
        "match": {
          "type": "regex",
          "pattern": "\\b(?:rg|ripgrep)\\b[^\\n;|&]*\\s--files\\b",
          "flags": "i",
        },
        "action": {
          "type": "warn",
          "message": "Use native `find` tool for file lookup.",
        },
      },
      {
        "id": "prefer-native-file-discovery-git-ls-files",
        "match": {
          "type": "regex",
          "pattern": "\\bgit\\b[^\\n;|&]*\\bls-files\\b",
          "flags": "i",
        },
        "action": {
          "type": "warn",
          "message": "Use native `find` tool for file lookup.",
        },
      },
      {
        "id": "prefer-native-content-search",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": [
            "rg",
            "ripgrep",
            "ag",
            "ack",
            "ack-grep",
            "pt",
            "ugrep",
            "sift",
            "grep",
            "ggrep",
            "findstr",
            "select-string",
          ],
          "patterns": [
            "^(?:rg|ripgrep|ag|ack(?:-grep)?|pt|ugrep|sift|grep|ggrep|findstr|select-string)(?:\\.exe)?$",
          ],
        },
        "action": {
          "type": "warn",
          "message": "Use native `grep` tool for repo search.",
        },
      },
      {
        "id": "prefer-native-content-search-git-grep",
        "match": {
          "type": "regex",
          "pattern": "\\bgit\\b[^\\n;|&]*\\bgrep\\b",
          "flags": "i",
        },
        "action": {
          "type": "warn",
          "message": "Use native `grep` tool for repo search.",
        },
      },
      {
        "id": "prefer-native-file-discovery",
        "match": {
          "type": "executable",
          "caseSensitive": false,
          "names": [
            "fd",
            "fdfind",
            "fd-find",
            "find",
            "gfind",
            "locate",
            "mlocate",
            "plocate",
          ],
          "patterns": [
            "^(?:fd|fdfind|fd-find|find|gfind|locate|mlocate|plocate)(?:\\.exe)?$",
          ],
        },
        "action": {
          "type": "warn",
          "message": "Use native `find` tool for file lookup.",
        },
      },
    ],
  },
  "protectedPaths": {
    "rules": [
      {
        "id": "no-read-env",
        "pattern": ".env",
        "tools": ["read"],
        "action": {
          "type": "block",
          "message": "Reading .env files is blocked by guardrails.",
        },
      },
      {
        "id": "no-read-git",
        "pattern": ".git",
        "tools": ["read"],
        "action": {
          "type": "block",
          "message": "Reading .git internals is blocked by guardrails.",
        },
      },
      {
        "id": "no-write-env",
        "pattern": ".env",
        "tools": ["write", "edit"],
        "action": {
          "type": "block",
          "message": "Writing .env files is blocked by guardrails.",
        },
      },
      {
        "id": "no-write-git",
        "pattern": ".git",
        "tools": ["write", "edit"],
        "action": {
          "type": "block",
          "message": "Writing .git internals is blocked by guardrails.",
        },
      },
      {
        "id": "no-write-node-modules",
        "pattern": "node_modules",
        "tools": ["write", "edit"],
        "action": {
          "type": "block",
          "message": "Writing node_modules is blocked by guardrails.",
        },
      },
    ],
  },
}
