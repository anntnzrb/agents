{
  "cacheWarming": "idle",
  "collapseChangelog": true,
  "codemode": {
    "mode": "on",
    "inlineBudget": 6000
  },
  "defaultTools": ["bash", "read", "write", "edit", "apply_patch", "codemode"],
  "doubleEscapeAction": "none",
  "editorPaddingX": 1,
  "extensions": ["-builtin:llama.cpp", "-extensions/find/index.ts"],
  "packages": [
    "npm:pi-subagents@0.79.0",
    "npm:@vanillagreen/pi-background-tasks@2.2.0",
    "npm:@howaboua/pi-ask@0.0.14"
  ],
  "find": {
    "classifier": "cliproxy/typesafe/jev-1.13"
  },
  "followUpMode": "all",
  "subagents": {
    "agentOverrides": {
      "scout": { "model": "cliproxy/gemini-3.8-flash-high", "thinking": "medium" },
      "worker": { "model": "cliproxy/gpt-6.1-sol", "thinking": "medium" },
      "delegate": { "model": "cliproxy/gpt-6.1-sol", "thinking": "medium" },
      "reviewer": { "model": "cliproxy/gpt-6.1-sol", "thinking": "xhigh" },
      "researcher": { "disabled": true },
      "evidence-auditor": { "disabled": true },
      "oracle": { "disabled": true }
    }
  },
  "hideThinkingBlock": true,
  "lastChangelogVersion": "1.0.0",
  "enabledModels": [
    "cliproxy/claude-opus-5-5:medium",
    "cliproxy/gpt-6.1-sol:medium",
    "cliproxy/opencode-go/muse-spark-1.3-contributor:xhigh",
    "cliproxy/opencode-go/deepseek-v4.1-flash:max"
  ],
  "quietStartup": "header",
  "showHardwareCursor": true,
  "steeringMode": "all",
  "theme": "ef-elea-light/ef-elea-dark",
  "terminal": {
    "showImages": false
  }
}
