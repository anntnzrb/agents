{
  "$schema": "https://opencode.ai/config.json",

  /* **************************************************************************
   * MODELS
   * ************************************************************************ */

  // title, summary, and compaction utils
  "small_model": "cliproxy/antigravity/gemini-3.7-flash-high",

  // main agent (build)
  "model": "cliproxy/chatgpt/gpt-5.6-sol",

  /* **************************************************************************
   * PLUGINS
   * ************************************************************************ */

  // "plugin": [],

  /* **************************************************************************
   * PROVIDERS
   * ************************************************************************ */

  "provider": {
    "cliproxy": {
      "name": "CLIProxyAPI",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "keyless",
        "baseURL": "${CLIPROXY_CLIENT_BASE_URL}",
      },
    },
  },

  "default_agent": "build",

  "subagent_depth": 2,

  "agent": {
    "build": {
      "model": "cliproxy/chatgpt/gpt-5.6-sol",
      "variant": "high",
      "description":
        "Orchestrator Agent: executes tools and delegates exploration and analysis to subagents in parallel to keep the main context lean.",
      "permission": {
        "bash": { "*": "deny" },
        "grep": { "*": "deny" },
        "glob": { "*": "deny" },
      },
    },
    "plan": {
      "disable": true,
    },
    "general": {
      "model": "cliproxy/antigravity/gemini-3.7-flash-high",
      "variant": "max",
      "description":
        "General-purpose subagent for researching complex questions and executing multi-step tasks in a fresh, isolated context. Use this agent to delegate units of work in parallel; it returns only its final summary to the orchestrator, keeping the main session context clean.",
      "permission": {
        "task": { "*": "deny", "explore": "allow" },
      },
    },
    "explore": {
      "model": "cliproxy/antigravity/gemini-3.7-flash-high",
      "variant": "max",
      "description":
        "Fast, read-only subagent specialized for exploring codebases: find files by pattern, search code by keyword, answer codebase questions. Use it to delegate searches and keep the orchestrator context clean. Specify thoroughness: 'quick', 'medium', or 'very thorough'.",
      "permission": {
        "edit": { "*": "deny" },
      },
    },
  },

  /* **************************************************************************
   * PERMISSIONS
   * ************************************************************************ */

  "permission": "allow",

  /* **************************************************************************
   * SERVER
   * ************************************************************************ */

  // "server": {
  //   "hostname": "0.0.0.0",
  //   "port": 4096,
  //   "mdns": false,
  // },

  /* **************************************************************************
   * MISC
   * ************************************************************************ */

  "autoupdate": false,
  "share": "manual",
  "formatter": false,
  "lsp": false,
    "experimental": {
    "disable_paste_summary": true,
  },
}
