{
  "$schema": "https://opencode.ai/config.json",

  "model": "cliproxy/gemini-3.8-flash-high",
  "warming": true,

  "plugins": [
    {
      "package": "./plugins/cliproxy",
      "options": { "baseURL": "${CLIPROXY_CLIENT_BASE_URL}" },
    },
  ],

  "providers": {
    "cliproxy": {
      "name": "CLIProxyAPI",
      "package": "@opencode/ai/providers/openai",
      "settings": {
        "apiKey": "keyless",
      },
    },
  },

  "agents": {
    "plan": {
      "disabled": true,
    },
    "build": {
      "description":
        "Orchestrator Agent: executes tools and delegates exploration, wide searches, and analysis to subagents in parallel to keep the main context lean.",
      "system":
        "You are the orchestrator agent. Never block on long work: stay available to the user while work runs in the background. Delegate multi-file searches, open-ended exploration, and heavy research to subagents in parallel, and run any shell command that is not near-instant in the background. Keep working or answer the user meanwhile; completion notifications arrive automatically, so do not poll or sleep. Synthesize subagent findings to plan and execute precise file edits and commands.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
      ],
    },
    "general": {
      "description":
        "Use proactively for researching complex questions, isolated investigations, and multi-step tasks in parallel. Returns only a concise final summary to keep the main session context clean.",
      "permissions": [
        { "action": "subagent", "resource": "explore", "effect": "allow" },
      ],
    },
    "title": {
      "model": "cliproxy/opencode-go/deepseek-v4.1-flash",
    },
    "explore": {
      "model": "cliproxy/opencode-go/deepseek-v4.1-flash",
      "description":
        "Read-only scout. Use proactively for exploring codebases (pattern matching, structural search, finding usages, multi-file analysis) and for web research through skills. Specify thoroughness: 'quick', 'medium', or 'very thorough'.",
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "allow" },
      ],
    },
  },

  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "deny" },
  ],

  "references": {
    "vendored": {
      "path": "~/src/vendored",
      "description":
        "Read-only upstream checkouts at <host>/<namespace>/<repo>, refreshed on a schedule. Read them for library and tool internals instead of relying on memory; never edit them.",
    },
  },

  "update": "disable",
  "websearch": false,
  "experimental": {
    "subagent_depth": 2,
    "background_compaction": true,
  },
}
