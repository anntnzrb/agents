{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$HOME/.codex/hooks/orchestration.py\" session-start",
            "commandWindows": "uv run --script \"%USERPROFILE%\\.codex\\hooks\\orchestration.py\" session-start",
            "timeout": 3,
            "additionalContextLimit": 600,
            "statusMessage": "Restoring coordinator state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$HOME/.codex/hooks/orchestration.py\" pre-tool-use",
            "commandWindows": "uv run --script \"%USERPROFILE%\\.codex\\hooks\\orchestration.py\" pre-tool-use",
            "timeout": 3,
            "statusMessage": "Checking agent fan-out budget"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$HOME/.codex/hooks/rtk.py\"",
            "timeout": 5,
            "statusMessage": "Rewriting command through RTK"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(worker-medium|worker-high|qa-executor|code-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$HOME/.codex/hooks/orchestration.py\" subagent-stop",
            "commandWindows": "uv run --script \"%USERPROFILE%\\.codex\\hooks\\orchestration.py\" subagent-stop",
            "timeout": 3,
            "statusMessage": "Checking worker evidence"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$HOME/.codex/hooks/orchestration.py\" session-end",
            "commandWindows": "uv run --script \"%USERPROFILE%\\.codex\\hooks\\orchestration.py\" session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
