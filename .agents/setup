#!/usr/bin/env bash
# Amp orb setup (Debian 12). The orb image already ships git, curl, jq,
# python3, uv, bun, node and npm, so this only prepares the repository.
# Idempotent. Editing it does not invalidate an orb snapshot; afterwards run
# `amp projects snapshots delete anntnzrb/annt-agents`.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# sync's pinned environment; uv fetches Python >=3.12 (the image has 3.11)
uv sync --frozen --project sync

# the sync quality gates on commit and push (.githooks/README)
git config --local core.hooksPath .githooks

# the shared env template; an existing .env is kept
if [ ! -f .env ]; then
  install -m 600 .env.example .env
fi

# Amp workspace settings (gitignored): orbs do not read the user settings sync
# publishes, so carry over the cost-control tool list
mkdir -p .amp
jq '{"amp.tools.disable": ."amp.tools.disable"}' harnesses/amp/settings.json >.amp/settings.json
