{
  "search": {
    "command": "uv run --script <skill-dir>/scripts/cli.py search \"<topic>\" 5",
    "query": "<topic>",
    "numResults": 5
  },
  "searchWithType": {
    "command": "uv run --script <skill-dir>/scripts/cli.py search \"<topic>\" 5 deep",
    "query": "<topic>",
    "numResults": 5,
    "type": "deep"
  },
  "contents": {
    "command": "uv run --script <skill-dir>/scripts/cli.py contents https://example.com/article",
    "urls": ["https://example.com/article"]
  },
  "answer": {
    "command": "uv run --script <skill-dir>/scripts/cli.py answer \"<question>\"",
    "query": "<question>"
  },
  "research": {
    "command": "uv run --script <skill-dir>/scripts/cli.py research \"<instructions>\" exa-research",
    "instructions": "<instructions>",
    "model": "exa-research"
  },
  "rawPost": {
    "command": "uv run --script <skill-dir>/scripts/cli.py post /search '{\"query\":\"<topic>\",\"numResults\":5}'",
    "path": "/search",
    "body": {
      "query": "<topic>",
      "numResults": 5
    }
  }
}
