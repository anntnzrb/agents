<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>false</NuGetAudit></PropertyGroup>
  <ItemGroup><Compile Include="Transform.fs" /><Compile Include="Examples.fs" /><Compile Include="Tests.fs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Expecto" Version="11.1.1" /><PackageReference Include="FsCheck" Version="3.4.0" /></ItemGroup>
</Project>
