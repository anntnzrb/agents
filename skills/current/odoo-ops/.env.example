# Odoo Ops Environment Configuration

# --- Remote / Production Read-Only JSON-RPC ---
# The JSON-RPC endpoint URL (defaults to https://erptech.espol.edu.ec/ or /jsonrpc)
ODOO_RPC_URL=https://erptech.espol.edu.ec/

# The target Odoo database name
ODOO_RPC_DB=espoltecherp

# The user login/email for authentication
ODOO_RPC_USER=erpespoltech@espol.edu.ec

# API token / password. You can supply ODOO_RPC_TOKEN directly OR provide
# a path to a file containing the token via ODOO_RPC_TOKEN_PATH.
ODOO_RPC_TOKEN=
ODOO_RPC_TOKEN_PATH=~/.erp-token

# SSL Certificate verification (true by default; set to false only if needed for self-signed certificates)
ODOO_RPC_VERIFY_SSL=true

# --- Local Container & Development Stack (odooctl) ---
ODOO_HTTP_PORT=8069
POSTGRES_PORT=5432
ODOO_DB_HOST=127.0.0.1
ODOO_DB_USER=odoo
ODOO_DB_PASS=odoo
ODOO_DB_NAME=erptech_0817
ODOO_RUNTIME_PATH=/opt/odoo17
ODOO_ADDONS_PATH=~/repos/etech/odoo/addons
