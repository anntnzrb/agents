# Connection settings are not consent. Every RPC call requires --allow-rpc
# after explicit user approval. Mutations additionally require --write and
# separate approval of exact targets, values, and side effects.
# Use --env-file to select this file explicitly; never commit real credentials.

ODOO_RPC_URL=https://erp.example.com/jsonrpc
ODOO_RPC_DB=approved-database
ODOO_RPC_USER=reader@example.com

# Supply a token through the environment or a protected token file.
ODOO_RPC_TOKEN=
ODOO_RPC_TOKEN_PATH=

# Keep certificate verification enabled for production.
ODOO_RPC_VERIFY_SSL=true

# Local disposable replica only. Disable its outbound integrations before use.
ODOO_HTTP_PORT=8069
POSTGRES_PORT=5432
ODOO_DB_HOST=127.0.0.1
ODOO_DB_USER=odoo
ODOO_DB_PASS=odoo
ODOO_DB_NAME=local-replica
ODOO_RUNTIME_PATH=/path/to/local/runtime
ODOO_ADDONS_PATH=/path/to/local/addons
