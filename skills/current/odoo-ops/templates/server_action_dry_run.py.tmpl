# Model: {{ model_name }}
# Purpose: dry run only. No create/write/unlink. No sudo. JSON directo.

Model = env['{{ model_name }}']
EXPECTED_TOTAL = {{ expected_total }}
EXPECTED_TO_UPDATE = {{ expected_to_update }}
DOMAIN = {{ domain_literal }}
TARGET_IDS = {{ target_ids_literal }}
EXCLUDED_IDS = {{ excluded_ids_literal }}
GROUP_FIELDS = [{{ group_fields_literal }}]  # optional program/user/stage mappings by numeric IDs
WRITE_EXECUTED = False


def esc(value):
    if value is None:
        return 'null'
    if value is False:
        return 'false'
    if value is True:
        return 'true'
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, (list, tuple)):
        return '[' + ','.join([esc(v) for v in value]) + ']'
    if isinstance(value, set):
        return '[' + ','.join([esc(v) for v in sorted(value)]) + ']'
    if isinstance(value, dict):
        return '{' + ','.join([esc(str(k)) + ':' + esc(v) for k, v in value.items()]) + '}'
    text = str(value)
    out = []
    for ch in text:
        code = ord(ch)
        if ch == '\\':
            out.append('\\\\')
        elif ch == '"':
            out.append('\\"')
        elif ch == '\b':
            out.append('\\b')
        elif ch == '\f':
            out.append('\\f')
        elif ch == '\n':
            out.append('\\n')
        elif ch == '\r':
            out.append('\\r')
        elif ch == '\t':
            out.append('\\t')
        elif code < 0x20:
            out.append('\\u%04x' % code)
        else:
            out.append(ch)
    return '"' + ''.join(out) + '"'


def pair(key, value):
    return esc(str(key)) + ':' + esc(value)


def raw_pair(key, raw_json):
    return esc(str(key)) + ':' + str(raw_json)


def obj(items):
    return '{' + ','.join(items) + '}'


def arr(values):
    return '[' + ','.join([esc(value) for value in values]) + ']'


def m2o(value):
    if not value:
        return 'null'
    return obj([pair('id', value[0]), pair('name', value[1])])


def group_obj(row, group_field):
    group_value = row.get(group_field)
    return obj([
        pair('key', group_value and (group_value[0] if isinstance(group_value, (list, tuple)) else group_value) or False),
        pair('label', group_value and (group_value[1] if isinstance(group_value, (list, tuple)) else group_value) or False),
        pair('count', row.get(group_field + '_count') or row.get('__count') or 0),
    ])


def groups_payload(domain):
    chunks = []
    for group_field in GROUP_FIELDS[:3]:
        rows = Model.read_group(domain, ['id:count'], [group_field], lazy=False)
        chunks.append(obj([
            pair('field', group_field),
            raw_pair('rows', '[' + ','.join([group_obj(row, group_field) for row in rows]) + ']'),
        ]))
    return '[' + ','.join(chunks) + ']'


error = False
if TARGET_IDS:
    if (
        not isinstance(TARGET_IDS, (list, tuple, set))
        or any(isinstance(x, bool) or not isinstance(x, int) or x <= 0 for x in TARGET_IDS)
    ):
        error = 'invalid_target_ids'
    elif len(set(TARGET_IDS)) != len(TARGET_IDS):
        error = 'duplicate_target_ids'
    elif len(TARGET_IDS) != EXPECTED_TO_UPDATE:
        error = 'target_ids_count_mismatch'
    elif EXCLUDED_IDS and not set(TARGET_IDS).isdisjoint(set(EXCLUDED_IDS)):
        error = 'target_and_excluded_ids_overlap'

TO_UPDATE_DOMAIN = list(DOMAIN) + [{{ extra_predicates }}]
if TARGET_IDS:
    TO_UPDATE_DOMAIN.append(('id', 'in', list(TARGET_IDS)))
if EXCLUDED_IDS:
    TO_UPDATE_DOMAIN.append(('id', 'not in', list(EXCLUDED_IDS)))

total = Model.search_count(DOMAIN)
to_update = Model.search_count(TO_UPDATE_DOMAIN) if not error else 0
first = Model.search(TO_UPDATE_DOMAIN, order='id asc', limit=1) if not error else Model.browse()
last = Model.search(TO_UPDATE_DOMAIN, order='id desc', limit=1) if not error else Model.browse()

if not error:
    if total != EXPECTED_TOTAL:
        error = 'total_count_mismatch'
    elif to_update != EXPECTED_TO_UPDATE:
        error = 'to_update_count_mismatch'

payload = obj([
    pair('model', '{{ model_name }}'),
    pair('status', error and 'failed' or 'ok'),
    pair('error', error),
    pair('domain_total', total),
    pair('expected_total', EXPECTED_TOTAL),
    pair('to_update', to_update),
    pair('expected_to_update', EXPECTED_TO_UPDATE),
    pair('first_to_update_id', first and first.id or False),
    pair('last_to_update_id', last and last.id or False),
    pair('target_ids', TARGET_IDS),
    pair('excluded_ids', EXCLUDED_IDS),
    raw_pair('distribution', groups_payload(TO_UPDATE_DOMAIN) if not error else '[]'),
    pair('write_executed', WRITE_EXECUTED),
])
raise UserError(payload)
