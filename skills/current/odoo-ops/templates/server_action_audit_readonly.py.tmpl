# Model: {{ model_name }}
# Purpose: {{ purpose }}
# No create/write/unlink. No sudo. JSON directo.

Model = env['{{ model_name }}']
EXPECTED_TOTAL = {{ expected_total }}
DOMAIN = {{ domain_literal }}
GROUP_FIELDS = [{{ group_fields_literal }}]  # up to three fields, e.g. 'stage_id', 'user_id', 'program_id'


def esc(value):
    if value is None:
        return 'null'
    if value is False:
        return 'false'
    if value is True:
        return 'true'
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, (list, tuple)):
        return '[' + ','.join([esc(v) for v in value]) + ']'
    if isinstance(value, set):
        return '[' + ','.join([esc(v) for v in sorted(value)]) + ']'
    if isinstance(value, dict):
        return '{' + ','.join([esc(str(k)) + ':' + esc(v) for k, v in value.items()]) + '}'
    text = str(value)
    out = []
    for ch in text:
        code = ord(ch)
        if ch == '\\':
            out.append('\\\\')
        elif ch == '"':
            out.append('\\"')
        elif ch == '\b':
            out.append('\\b')
        elif ch == '\f':
            out.append('\\f')
        elif ch == '\n':
            out.append('\\n')
        elif ch == '\r':
            out.append('\\r')
        elif ch == '\t':
            out.append('\\t')
        elif code < 0x20:
            out.append('\\u%04x' % code)
        else:
            out.append(ch)
    return '"' + ''.join(out) + '"'


def pair(key, value):
    return esc(str(key)) + ':' + esc(value)


def raw_pair(key, raw_json):
    return esc(str(key)) + ':' + str(raw_json)


def obj(items):
    return '{' + ','.join(items) + '}'


def arr(values):
    return '[' + ','.join([esc(value) for value in values]) + ']'


def m2o(value):
    if not value:
        return 'null'
    return obj([pair('id', value[0]), pair('name', value[1])])


def group_obj(row, group_field):
    group_value = row.get(group_field)
    return obj([
        pair('key', group_value and (group_value[0] if isinstance(group_value, (list, tuple)) else group_value) or False),
        pair('label', group_value and (group_value[1] if isinstance(group_value, (list, tuple)) else group_value) or False),
        pair('count', row.get(group_field + '_count') or row.get('__count') or 0),
    ])


def groups_payload():
    chunks = []
    for group_field in GROUP_FIELDS[:3]:
        rows = Model.read_group(DOMAIN, ['id:count'], [group_field], lazy=False)
        chunks.append(obj([
            pair('field', group_field),
            raw_pair('rows', '[' + ','.join([group_obj(row, group_field) for row in rows]) + ']'),
        ]))
    return '[' + ','.join(chunks) + ']'


total = Model.search_count(DOMAIN)
first = Model.search(DOMAIN, order='id asc', limit=1)
last = Model.search(DOMAIN, order='id desc', limit=1)

payload = obj([
    pair('model', '{{ model_name }}'),
    pair('domain', DOMAIN),
    pair('expected_total', EXPECTED_TOTAL),
    pair('total', total),
    pair('count_matches', total == EXPECTED_TOTAL),
    pair('first_id', first and first.id or False),
    pair('last_id', last and last.id or False),
    raw_pair('groups', groups_payload()),
    pair('write_executed', False),
])
raise UserError(payload)
