{
  "webSearch": {
    "command": "brave-search web \"<topic>\" result_filter=web",
    "query": "<topic>",
    "result_filter": "web"
  },
  "newsSearch": {
    "command": "brave-search news \"<topic>\" freshness=pd",
    "query": "<topic>",
    "freshness": "pd"
  },
  "localSearch": {
    "command": "brave-search local \"<business or place>\"",
    "query": "<business or place>"
  },
  "imageSearch": {
    "command": "brave-search image \"<topic>\" safesearch=strict",
    "query": "<topic>",
    "safesearch": "strict"
  },
  "videoSearch": {
    "command": "brave-search video \"<topic>\"",
    "query": "<topic>"
  },
  "summarizerKey": {
    "command": "brave-search summarizer-key \"<topic>\"",
    "query": "<topic>",
    "_deprecated": true,
    "_note": "Legacy / experimental flow. Prefer default compact endpoints. Returns rc=1 when Brave declines to summarize."
  },
  "summarizer": {
    "command": "brave-search summarize \"<summary_key>\" inline_references=true",
    "key": "<summary_key>",
    "inline_references": true,
    "_deprecated": true,
    "_note": "Legacy / experimental flow. Use raw passthrough or the compact endpoints instead."
  }
}
