# Odoo 17 / Python 3.10 — read-only modern Python capability gauntlet
# Model: crm.lead
#
# Run this as an Execute Python Code Server Action on crm.lead. It may be
# launched with zero, one, or many selected leads. Every ORM query is bounded by
# the selected IDs; an empty selection produces an empty-domain audit.
#
# This intentionally exercises only constructs that are expected to compile
# under Python 3.10 AND pass Odoo 17's safe_eval opcode allowlist.
#
# Safety contract:
# - no imports, sudo, create, write, unlink, SQL, commit, rollback, logging,
#   network, filesystem, secrets, or external calls;
# - no structural match, variable annotations, closures, with statements, or
#   walrus inside module-scope comprehensions because their opcodes are unsafe;
# - output is compact JSON through UserError, so no transaction is committed.


# ---------------------------------------------------------------------------
# Pure JSON boundary helpers
# ---------------------------------------------------------------------------

def json_string(value: str, /) -> str:
    """Encode one JSON string without importing json."""
    text = str(value)
    text = text.replace('\\', '\\\\').replace('"', '\\"')
    text = text.replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')
    return '"' + text + '"'


def json_value(value) -> str:
    """Encode the bounded primitive containers used by this audit."""
    if value is None:
        return 'null'
    if value is False:
        return 'false'
    if value is True:
        return 'true'
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, dict):
        items = [
            json_string(key) + ':' + json_value(item)
            for key, item in value.items()
        ]
        return '{' + ','.join(items) + '}'
    if isinstance(value, (list, tuple)):
        return '[' + ','.join(json_value(item) for item in value) + ']'
    if isinstance(value, set):
        return '[' + ','.join(json_value(item) for item in sorted(value)) + ']'
    return json_string(value)


def check(name: str, ok: bool, detail='') -> dict:
    """Create an immutable-by-convention check result."""
    return {'name': name, 'ok': bool(ok), 'detail': detail}


# ---------------------------------------------------------------------------
# Modern syntax, annotations, decorators, generators, and functional helpers
# ---------------------------------------------------------------------------

def transparent(function):
    """Import-free decorator with no closure; returns the callable unchanged."""
    return function


@transparent
def decorated_increment(value: int, /, *, step: int = 1) -> int:
    """Exercise decorator syntax, annotations, positional-only and keyword-only."""
    return value + step


def even_squares(limit: int, /):
    """Generator function: lazy, bounded, and side-effect free."""
    for number in range(limit):
        if number % 2 == 0:
            yield number * number


def classify_scalar(value: str, /) -> str:
    """Literal-only match is opcode-compatible; structural match is not."""
    match value:
        case 'ok':
            return 'success'
        case 'failed':
            return 'failure'
        case _:
            return 'unknown'


def apply_pipeline(value: int, functions: list, /) -> int:
    """Higher-order pipeline without closures; reduce has an initializer."""
    return reduce(lambda current, function: function(current), functions, value)


def double(value: int, /) -> int:
    return value * 2


def add_three(value: int, /) -> int:
    return value + 3


checks = []
numbers = [1, 2, 3, 4, 5, 6]

# Comprehensions: keep each transformation single-purpose and bounded.
squares = [number * number for number in numbers]
even_lookup = {number: number * number for number in numbers if number % 2 == 0}
unique_remainders = {number % 3 for number in numbers}
flattened = [item for row in [[1, 2], [3, 4]] for item in row]
checks.append(check('list_comprehension', squares == [1, 4, 9, 16, 25, 36]))
checks.append(check('dict_comprehension', even_lookup == {2: 4, 4: 16, 6: 36}))
checks.append(check('set_comprehension', unique_remainders == {0, 1, 2}))
checks.append(check('bounded_flattening', flattened == [1, 2, 3, 4]))

# Generator function and generator expression.
checks.append(check('generator_function', list(even_squares(7)) == [0, 4, 16, 36]))
checks.append(check('generator_expression', sum(number * number for number in numbers) == 91))
checks.append(check('generator_all', all(number > 0 for number in numbers)))
checks.append(check('generator_any', any(number == 4 for number in numbers)))

# Functional built-ins injected directly by safe_eval.
checks.append(check('map', list(map(double, numbers)) == [2, 4, 6, 8, 10, 12]))
checks.append(check('filter', list(filter(lambda value: value % 2 == 0, numbers)) == [2, 4, 6]))
checks.append(check('reduce', reduce(lambda total, value: total + value, numbers, 0) == 21))
checks.append(check('pipeline', apply_pipeline(5, [double, add_three]) == 13))
checks.append(check('sorted_key', sorted(numbers, key=lambda value: -value) == [6, 5, 4, 3, 2, 1]))
checks.append(check('zip', list(zip([1, 2], ['a', 'b'])) == [(1, 'a'), (2, 'b')]))
checks.append(check('enumerate', list(enumerate(['a', 'b'])) == [(0, 'a'), (1, 'b')]))

# Decorator syntax and function annotations compile and execute. This does not
# claim that imported decorators or closure-producing decorators are available.
checks.append(check('decorator_no_closure', decorated_increment(4, step=3) == 7))
checks.append(check('function_annotations_compile', decorated_increment(1) == 2))
checks.append(check('positional_keyword_only', decorated_increment(2, step=4) == 6))

# Literal scalar match works because Python 3.10 lowers it to allowed compare
# opcodes. Sequence/mapping/class patterns are intentionally absent.
checks.append(check('match_literal', classify_scalar('ok') == 'success'))
checks.append(check('match_wildcard', classify_scalar('other') == 'unknown'))

# Walrus is used only in simple statement scope; placing it in a module-level
# comprehension can emit blacklisted STORE_GLOBAL.
walrus_ok = False
if (number_count := len(numbers)) == 6:
    walrus_ok = number_count == 6
checks.append(check('walrus_simple', walrus_ok))

# Copy-on-write dict merge: original dictionaries remain unchanged.
defaults = {'mode': 'audit', 'limit': 10}
overrides = {'limit': 5, 'active': True}
merged = defaults | overrides
checks.append(check('dict_merge', merged == {'mode': 'audit', 'limit': 5, 'active': True}))
checks.append(check('dict_merge_copy_on_write', defaults == {'mode': 'audit', 'limit': 10}))

# Python 3.8/3.9 string and f-string conveniences.
filename = 'audit_crm_lead.py'
checks.append(check('removeprefix', filename.removeprefix('audit_') == 'crm_lead.py'))
checks.append(check('removesuffix', filename.removesuffix('.py') == 'audit_crm_lead'))
checks.append(check('self_documenting_fstring', f'{number_count=}' == 'number_count=6'))

# Ordered deduplication: O(n) membership while preserving first-seen order.
raw_ids = [3, 1, 3, 2, 1]
seen_ids = set()
ordered_ids = []
duplicate_ids = []
for item_id in raw_ids:
    if item_id in seen_ids:
        duplicate_ids.append(item_id)
    else:
        seen_ids.add(item_id)
        ordered_ids.append(item_id)
checks.append(check('set_ordered_dedup', ordered_ids == [3, 1, 2]))
checks.append(check('duplicate_reporting', duplicate_ids == [3, 1]))

# Specific boundary handling: catch only the provided Exception base and verify
# the expected failure, never convert an unknown business failure into success.
expected_exception_caught = False
try:
    impossible = 1 / 0
except Exception:
    expected_exception_caught = True
checks.append(check('specific_test_exception_path', expected_exception_caught))

# Injected Odoo/Python helpers. These calls are pure and bounded.
checks.append(check('float_compare', float_compare(1.0, 1.0, precision_digits=2) == 0))
encoded = b64encode(b'odoo-safe-eval')
checks.append(check('base64_round_trip', b64decode(encoded) == b'odoo-safe-eval'))
checks.append(check('command_namespace', bool(Command.clear())))
checks.append(check('datetime_wrapper', datetime.datetime(2024, 1, 2).year == 2024))
checks.append(check('time_wrapper', time.strftime('%Y', time.strptime('1970', '%Y')) == '1970'))
checks.append(check('timezone_helper', bool(timezone('UTC'))))


# ---------------------------------------------------------------------------
# Read-only ORM audit bounded by the current contextual selection
# ---------------------------------------------------------------------------

active_model = env.context.get('active_model')
active_ids = env.context.get('active_ids') or []
max_selection = 1000
context_model_ok = active_model in (None, 'crm.lead')
checks.append(check('active_model_boundary', context_model_ok, active_model or 'none'))
selection_within_limit = len(active_ids) <= max_selection
checks.append(check('selection_limit', selection_within_limit, len(active_ids)))

Lead = env['crm.lead']
selected = Lead.browse(active_ids).exists() if context_model_ok and selection_within_limit else Lead.browse()
selected_ids = selected.ids
selected_domain = [('id', 'in', selected_ids)]

checks.append(check('exists_for_stale_ids', all(lead_id in selected_ids for lead_id in selected.ids)))
checks.append(check('search_count_bounded', Lead.search_count(selected_domain) == len(selected)))
selected_id_set = set(selected_ids)
checks.append(check('recordset_filtered', selected.filtered(lambda lead: lead.id in selected_id_set).ids == selected_ids))
checks.append(check('recordset_mapped', selected.mapped('id') == selected_ids))

active_groups = Lead.read_group(
    selected_domain,
    ['id:count'],
    ['active'],
    lazy=False,
)
grouped_count = sum(row.get('__count') or row.get('active_count') or 0 for row in active_groups)
checks.append(check('read_group_bounded', grouped_count == len(selected)))

# Bounded sample, never a full clipboard dump.
sample = selected[:5].read(['id', 'name', 'active'], load=False)
checks.append(check('bounded_sample', len(sample) <= 5))


# ---------------------------------------------------------------------------
# Final machine-readable report
# ---------------------------------------------------------------------------

passed = sum(1 for item in checks if item.get('ok'))
failed = [item.get('name') for item in checks if not item.get('ok')]
all_ok = passed == len(checks)

payload = {
    'status': 'ok' if all_ok else 'failed',
    'model': 'crm.lead',
    'python_target': '3.10',
    'safe_eval_profile': 'odoo17',
    'check_count': len(checks),
    'passed_count': passed,
    'failed_count': len(failed),
    'failed_checks': failed,
    'selected_count': len(selected),
    'selected_ids': selected_ids[:20],
    'sample': sample,
    'checks': checks,
    'intentionally_excluded': [
        'imports',
        'itertools_and_functools_modules',
        'variable_annotations',
        'capturing_closures',
        'structural_match_sequence_mapping_class',
        'with_statement',
        'walrus_inside_module_comprehension',
        'sudo_and_mutations',
    ],
    'write_executed': False,
}
raise UserError(json_value(payload))

