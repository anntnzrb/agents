{
  "search": {
    "command": "exa-search search \"<topic>\" 5",
    "query": "<topic>",
    "numResults": 5
  },
  "searchWithType": {
    "command": "exa-search search \"<topic>\" 5 deep",
    "query": "<topic>",
    "numResults": 5,
    "type": "deep"
  },
  "contents": {
    "command": "exa-search contents https://example.com/article",
    "urls": [
      "https://example.com/article"
    ]
  },
  "answer": {
    "command": "exa-search answer \"<question>\"",
    "query": "<question>"
  },
  "research": {
    "command": "exa-search research \"<instructions>\" exa-research",
    "instructions": "<instructions>",
    "model": "exa-research"
  },
  "rawPost": {
    "command": "exa-search post /search '{\"query\":\"<topic>\",\"numResults\":5}'",
    "path": "/search",
    "body": {
      "query": "<topic>",
      "numResults": 5
    }
  }
}
