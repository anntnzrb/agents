host: "${CLIPROXY_LISTEN_HOST}"
port: ${CLIPROXY_LISTEN_PORT}

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: true
  secret-key: tailnet
  disable-control-panel: false
  disable-auto-update-panel: true

auth-dir: "~/.cli-proxy-api"

debug: false
logging-to-file: false
usage-statistics-enabled: true
disable-image-generation: "chat"
force-model-prefix: true
ws-auth: false

request-retry: 3
max-retry-credentials: 0
max-retry-interval: 30
disable-cooling: false
save-cooldown-status: true

streaming:
  bootstrap-retries: 1

routing:
  strategy: "weighted-round-robin"
  session-affinity: true
  session-affinity-ttl: "1h"

codex:
  identity-confuse: false
  disable-codex-cloaking: false
  optimize-multi-agent-v2: false

oauth-model-alias:
  antigravity:
    - name: "gemini-3.7-flash-high"
      alias: "nnn-gemini-3.7-flash-medium"
      display-name: "[nnn] Gemini 3.7 Flash (Medium)"
      fork: true
      force-mapping: true
  codex:
    - name: "gpt-5.6-sol"
      alias: "nnn-gpt-5.6-sol-high"
      display-name: "[nnn] GPT-5.6 Sol (High)"
      fork: true
      force-mapping: true
    - name: "gpt-5.6-luna"
      alias: "nnn-gpt-5.6-luna-max"
      display-name: "[nnn] GPT-5.6 Luna (Max)"
      fork: true
      force-mapping: true

openai-compatibility:
  - name: "opencode-go-custom"
    prefix: "go"
    base-url: "https://opencode.ai/zen/go/v1"
    x-credential-pool: "opencode-go"
    models:
      - name: "deepseek-v4-flash"
        alias: "nnn-deepseek-v4-flash-max"
        display-name: "[nnn] DeepSeek V4 Flash (Max)"
        force-mapping: true
      - name: "deepseek-v4-pro"
        alias: "nnn-deepseek-v4-pro-max"
        display-name: "[nnn] DeepSeek V4 Pro (Max)"
        force-mapping: true
  - name: "cline-pass-custom"
    prefix: "cline-pass"
    base-url: "https://api.cline.bot/api/v1"
    x-credential-pool: "cline-pass"
    models:
      - name: "cline-pass/deepseek-v4-flash"
        alias: "nnn-deepseek-v4-flash-max"
        display-name: "[nnn] DeepSeek V4 Flash (Max)"
        force-mapping: true
      - name: "cline-pass/deepseek-v4-pro"
        alias: "nnn-deepseek-v4-pro-max"
        display-name: "[nnn] DeepSeek V4 Pro (Max)"
        force-mapping: true
      - name: "cline-pass/glm-5.3"
        alias: "nnn-glm-5.3-max"
        display-name: "[nnn] GLM 5.3 (Max)"
        force-mapping: true
      - name: "cline-pass/kimi-k3"
        alias: "nnn-kimi-k3-max"
        display-name: "[nnn] Kimi K3 (Max)"
        force-mapping: true
      - name: "cline-pass/qwen3.8-max"
        alias: "nnn-qwen3.8-max-xhigh"
        display-name: "[nnn] Qwen 3.8 Max (XHigh)"
        force-mapping: true

payload:
  override:
    - models:
        - name: "gemini-3.7-flash-high"
          protocol: "antigravity"
      params:
        "generationConfig.thinkingConfig.thinkingLevel": "medium"
    - models:
        - name: "gpt-5.6-sol"
          protocol: "codex"
      params:
        "reasoning.effort": "high"
    - models:
        - name: "gpt-5.6-luna"
          protocol: "codex"
      params:
        "reasoning.effort": "max"
    - models:
        - name: "deepseek-v4-flash"
        - name: "cline-pass/deepseek-v4-flash"
      params:
        reasoning_effort: "high"
    - models:
        - name: "deepseek-v4-pro"
        - name: "cline-pass/deepseek-v4-pro"
      params:
        reasoning_effort: "high"
    - models:
        - name: "deepseek-v4-flash-free"
      params:
        reasoning_effort: "high"
    - models:
        - name: "cline-pass/glm-5.3"
      params:
        reasoning_effort: "max"
    - models:
        - name: "cline-pass/kimi-k3"
      params:
        reasoning_effort: "max"
    - models:
        - name: "cline-pass/qwen3.8-max"
      params:
        reasoning_effort: "xhigh"

x-model-sources:
  - id: "opencode-go"
    models-dev-provider: "opencode-go"
    credential-pool: "opencode-go"
    prefix: "go"
    base-url: "https://opencode.ai/zen/go/v1"
  - id: "opencode-zen"
    models-dev-provider: "opencode"
    credential-pool: "opencode-zen"
    prefix: "zen"
    base-url: "https://opencode.ai/zen/v1"
  - id: "cline-pass"
    models-dev-provider: "cline-pass"
    credential-pool: "cline-pass"
    prefix: "cline-pass"
    base-url: "https://api.cline.bot/api/v1"
    models-url: "https://api.cline.bot/api/v1/ai/cline/recommended-models"
    models-field: "clinePass"

oauth-excluded-models:
  antigravity:
    - "claude-*"
    - "gpt-oss-*"
    - "gemini-3-flash*"
    - "gemini-3.1-*"
    - "gemini-3.5-*"
    - "gemini-3.6-*"
    - "gemini-pro-agent"
  codex:
    - "codex-auto-review"
    - "gpt-5"
    - "gpt-5.1*"
    - "gpt-5.2*"
    - "gpt-5.3*"
    - "gpt-5.4*"
    - "gpt-5.5*"
    - "gpt-image-*"
  xai:
    - "grok-3-*"
    - "grok-4.20-*"
    - "grok-4.3"
    - "grok-4.5"
    - "grok-build-*"
    - "grok-composer-*"
    - "grok-imagine-*"
