{
  "mcpServers": {
    "deepwiki": {
      "description": "DeepWiki MCP",
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    },
    "n8n": {
      "description": "n8n MCP",
      "command": "bun",
      "args": [
        "x",
        "supergateway",
        "--streamableHttp",
        "${N8N_MCP_URL}",
        "--header",
        "Authorization: Bearer ${N8N_MCP_TOKEN}"
      ]
    }
  }
}
