host: "127.0.0.1"
port: 8317

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: false
  secret-key: ${CLIPROXY_MANAGEMENT_KEY}
  disable-control-panel: false
  disable-auto-update-panel: true

auth-dir: "~/.cli-proxy-api"

api-keys: ${CLIPROXY_CLIENT_API_KEYS}

debug: false
logging-to-file: false
usage-statistics-enabled: true
disable-image-generation: "chat"
force-model-prefix: true
ws-auth: true

request-retry: 1
max-retry-credentials: 0
disable-cooling: false
save-cooldown-status: true

routing:
  strategy: "weighted-round-robin"
  session-affinity: true
  session-affinity-ttl: "1h"

codex:
  identity-confuse: false
  disable-codex-cloaking: false
  optimize-multi-agent-v2: false

codex-api-key:
  - x-credential-pool: "opencode-go"
    prefix: "go"
    base-url: "https://opencode.ai/zen/go/v1"
    request-retry: 1
    models:
      - name: "gpt-5.6-luna"
        alias: "gpt-5.6-luna"
        display-name: "OpenCode Go - GPT 5.6 Luna"
        max-context-length: 272000
        force-mapping: true
        is-compat: true
        thinking:
          levels: ["xhigh", "high", "medium", "low"]
openai-compatibility:
  - x-credential-pool: "deepseek"
    name: "deepseek"
    prefix: "deepseek"
    base-url: "https://api.deepseek.com/v1"
    models:
      - name: "deepseek-v4-flash"
        alias: "deepseek-v4-flash"
      - name: "deepseek-v4-pro"
        alias: "deepseek-v4-pro"
  - x-credential-pool: "openrouter"
    name: "openrouter"
    prefix: "openrouter"
    base-url: "https://openrouter.ai/api/v1"
    models:
      - name: "openrouter/auto"
        alias: "auto"
  - x-credential-pool: "opencode-zen"
    name: "opencode-zen"
    prefix: "zen"
    base-url: "https://opencode.ai/zen/v1"
    models:
      - name: "minimax-m3"
        alias: "minimax-m3"
